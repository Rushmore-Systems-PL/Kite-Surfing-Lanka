@model IEnumerable<KSL_HMS.DB.BillDetail>

@{
    ViewBag.Billing = "active open";
    ViewBag.BillingMaster = "active open";
    ViewBag.BillDetails = "active";
    ViewBag.Title = "Bill Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Assest/vendor/libs/datatables-bs5/datatables.bootstrap5.css" rel="stylesheet" />
<link href="~/Assest/vendor/libs/toastr/toastr.css" rel="stylesheet" />
<link href="~/Assest/vendor/libs/animate-css/animate.css" rel="stylesheet" />

<div class="card">
    <div class="card-body">
        <h4>Bill Master</h4>
        <hr class="my-4 mx-n4" />
        <table class="datatables-basic table border-top" id="MasterTable">
            <thead>
                <tr>
                    <th class="text-center">#</th>
                    <th>Booking Reference</th>
                    <th>Location</th>
                    @*<th>Charge</th>   *@
                    <th>Cost</th>
                    <th>Quantity</th>
                    <th>Discount</th>
                    <th>Final Cost</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int i = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center" width="2px">
                                .@i.ToString("00")
                            </td>
                            <td>
                                @if (item.BillHeader.BookingRefference.bitExternalBooking == false)
                                {
                                    <span>Room: @item.BillHeader.BookingHeader.Room.varRoomNo | Ref: @item.BillHeader.BookingHeader.BookingRefference.varBookingRefferenceNo</span>
                                }
                                else
                                {
                                    <span>@item.BillHeader.BookingHeader.BookingRefference.varBookingRefferenceNo</span>
                                }
                            </td>
                            <td>
                                @if (item.numLocationID == null)
                                {
                                    <span>Room</span>
                                }
                                else
                                {
                                    <span>@item.Location.varLocationName</span>
                                }
                            </td>
                            @*<td>
                                @if (item.ChargeType.varChargeTypeName == "Room")
                                {
                                    <span>Room No: @item.Room.varRoomNo</span>
                                }
                                else
                                {
                                    <span>@item.Item.varItemName</span>
                                }
                            </td>*@
                            <td>
                                € @item.numCost
                            </td>
                            <td>
                                @item.numQuantity
                            </td>
                            <td>
                                @if (item.numDiscount == null)
                                {
                                    <span>N/A</span>
                                }
                                else
                                {
                                    <span>@item.numDiscount %</span>
                                }
                            </td>
                            <td>
                                € @item.numFinalCost
                            </td>
                            <td class="text-center">
                                @if (item.ChargeType.varChargeTypeName != "Item")
                                {
                                    <span class="text-nowrap">
                                        @*<a class="btn btn-sm btn-icon me-1 disabled" href="javascript:void(0);"><i class="bx bx-edit text-warning"></i></a>*@
                                        <button class="btn btn-sm btn-icon delete-record" onclick="javascript:void(0);" disabled><i class="bx bx-trash text-danger"></i></button>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-nowrap">
                                @*        <a class="btn btn-sm btn-icon me-1" href="@Url.Action("EditAddToBill", "BillDetails", new { id = item.numBillDetailID })"><i class="bx bx-edit text-warning"></i></a>*@
                                        <button class="btn btn-sm btn-icon delete-record" onclick="SetBillID(@item.numBillDetailID)"><i class="bx bx-trash text-danger"></i></button>
                                    </span>
                                }
                            </td>
                        </tr>
                        i++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="col-lg-3 col-md-6">
    <div class="mt-3">
        <div class="offcanvas offcanvas-bottom" data-bs-backdrop="false" tabindex="-1" id="BillDeleteCanvas" aria-labelledby="BillDeleteCanvasLabel">
            <div class="offcanvas-header">
                <h4 id="BillDeleteCanvasLabel" class="offcanvas-title">Bill</h4>
                <button type="button" class="btn-close text-reset" onclick="CancelBill()" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                <h5>Are You Sure?</h5>
                <p style="margin-top:-10px">Do You Want To Delete This Bill...!</p>
                <button type="button" class="btn btn-primary me-2" onclick="DeleteBill()">Continue</button>
                <button type="button" class="btn btn-warning" onclick="CancelBill()">Cancel</button>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Assest/vendor/libs/datatables/jquery.dataTables.js"></script>
<script src="~/Assest/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
<script src="~/Assest/vendor/libs/toastr/toastr.js"></script>
<script type="text/javascript">
    var numBillDetailID = 0;
    var table = $('#MasterTable').DataTable({
        scrollY: true,
        scrollX: true,
        scrollCollapse: true,
        paging: true,
        fixedColumns: false,
        ordering: false
    });
    function SetBillID(id) {
        numBillDetailID = id;
        $('#BillDeleteCanvas').offcanvas('show');
    }
    function DeleteBill() {
        $.ajax({
            type: "POST",
            url: '@Url.Action("Delete", "BillDetails")/' + numBillDetailID,
            success: function () {
                location.reload();
            }
        });
    }
    function CancelBill() {
        numBillDetailID = 0;
        $('#BillDeleteCanvas').offcanvas('hide');
    }
    $(function myfunction() {
        var Msg = '@TempData["BillDetailStatus"]'
        if (Msg != '') {
            if (Msg == "Deleted") {
                toastr.options = {
                    "closeButton": true,
                    "debug": false,
                    "newestOnTop": true,
                    "progressBar": true,
                    "positionClass": "toast-top-right",
                    "preventDuplicates": false,
                    "onclick": null,
                    "showDuration": "300",
                    "hideDuration": "1000",
                    "timeOut": "5000",
                    "extendedTimeOut": "1000",
                    "showEasing": "swing",
                    "hideEasing": "linear",
                };
                toastr["success"]("Bill Deleted Successfully.", " Success");
            } else if (Msg == "Edited") {
                toastr.options = {
                    "closeButton": true,
                    "debug": false,
                    "newestOnTop": true,
                    "progressBar": true,
                    "positionClass": "toast-top-right",
                    "preventDuplicates": false,
                    "onclick": null,
                    "showDuration": "300",
                    "hideDuration": "1000",
                    "timeOut": "5000",
                    "extendedTimeOut": "1000",
                    "showEasing": "swing",
                    "hideEasing": "linear",
                };
                toastr["success"]("Bill Updated Successfully.", " Success");
            }
        }
    })
</script>