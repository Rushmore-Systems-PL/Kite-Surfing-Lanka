@model IEnumerable<KSL_HMS.Models.BillHeaderDTO>

@{
    ViewBag.Billing = "active open";
    ViewBag.CloseBill = "active";
    ViewBag.Title = "Close Bill Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Assest/vendor/libs/datatables-bs5/datatables.bootstrap5.css" rel="stylesheet" />
<link href="~/Assest/vendor/libs/toastr/toastr.css" rel="stylesheet" />
<link href="~/Assest/vendor/libs/animate-css/animate.css" rel="stylesheet" />

<div class="card">
    <div class="card-body">
        <h4>Close Bill Master</h4>
        <hr class="my-4 mx-n4" />
        <table class="datatables-basic table border-top" id="MasterTable">
            <thead>
                <tr>
                    <th class="text-center">#</th>
                    <th>Booking Reference</th>
                    <th class="text-center">Bill Total</th>
                    <th class="text-center">Paid Amount</th>
                    <th class="text-center">Amount To Be Paid</th>
                    <th class="text-center">Info</th>
                    <th class="text-center">Close</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int i = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center" width="2px">
                                .@i.ToString("00")
                            </td>
                            <td>
                                @item.varBookingRefferenceNo
                            </td>
                            <td class="text-center">
                                € @item.numTotalCost
                            </td>
                            <td class="text-center">
                                € @item.numPayedAmount
                            </td>
                            <td class="text-center">
                                € @item.numBalanceToPay
                            </td>
                            <td class="text-center">
                                <span class="text-nowrap">
                                    <a class="btn btn-sm btn-icon me-1" href="@Url.Action("Details", "BillHeaders", new { id = item.numBookingRefferenceID })"><i class="bx bx-info-circle text-info"></i></a>
                                </span>
                            </td>
                            <td class="text-center">
                                @if (item.closed == true)
                                {
                                    <span class="badge bg-label-danger">Closed</span>
                                }
                                else if (item.closed == false)
                                {
                                    <button class="btn btn-sm btn-icon delete-record" onclick="SetBillHeadersID(@item.numBookingRefferenceID)"><i class="bx bx-task-x text-danger"></i></button>
                                }
                            </td>
                        </tr>
                        i++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="col-lg-3 col-md-6">
    <div class="mt-3">
        <div class="offcanvas offcanvas-bottom" data-bs-backdrop="false" tabindex="-1" id="BillHeadersDeleteCanvas" aria-labelledby="BillHeadersDeleteCanvasLabel">
            <div class="offcanvas-header">
                <h4 id="BillHeadersDeleteCanvasLabel" class="offcanvas-title">Close Bill</h4>
                <button type="button" class="btn-close text-reset" onclick="CancelBillHeaders()" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                <h5>Are You Sure?</h5>
                <p style="margin-top:-10px">Do You Want To Close This Bill...!</p>
                <button type="button" class="btn btn-primary me-2" onclick="DeleteBillHeaders()">Continue</button>
                <button type="button" class="btn btn-warning" onclick="CancelBillHeaders()">Cancel</button>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Assest/vendor/libs/datatables/jquery.dataTables.js"></script>
<script src="~/Assest/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
<script src="~/Assest/vendor/libs/toastr/toastr.js"></script>
<script type="text/javascript">
    var numBillHeaderID = 0;
    var table = $('#MasterTable').DataTable({
        scrollY: true,
        scrollX: true,
        scrollCollapse: true,
        paging: true,
        fixedColumns: false,
        ordering: false
    });
    function SetBillHeadersID(id) {
        numBillHeaderID = id;
        $('#BillHeadersDeleteCanvas').offcanvas('show');
    }
    function CancelBillHeaders() {
        numBillHeaderID = 0;
        $('#BillHeadersDeleteCanvas').offcanvas('hide');
    }
    function DeleteBillHeaders() {
        $.ajax({
            type: "POST",
            url: '@Url.Action("Close", "BillHeaders")/' + numBillHeaderID,
            success: function () {
                location.reload();
            }
        });
    }
    $(function myfunction() {
        var Msg = '@TempData.Peek("BillStatus")'
        if (Msg == "Deleted") {
            toastr.options = {
                "closeButton": true,
                "debug": false,
                "newestOnTop": true,
                "progressBar": true,
                "positionClass": "toast-top-right",
                "preventDuplicates": false,
                "onclick": null,
                "showDuration": "300",
                "hideDuration": "1000",
                "timeOut": "5000",
                "extendedTimeOut": "1000",
                "showEasing": "swing",
                "hideEasing": "linear",
            };
            toastr["success"]("Bill Closed Successfully.", " Success");
        }
    })
</script>

