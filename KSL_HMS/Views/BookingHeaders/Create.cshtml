@model KSL_HMS.DB.BookingHeader

@{
    ViewBag.NewInternalBooking = "active open";
    ViewBag.Booking = "active open";
    ViewBag.NewBooking = "active";
    ViewBag.Title = "New Booking";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Assest/vendor/libs/toastr/toastr.css" rel="stylesheet" />
<link href="~/Assest/vendor/libs/flatpickr/flatpickr.css" rel="stylesheet" />
<link href="~/Assest/vendor/libs/select2/select2.css" rel="stylesheet" />

<div class="card mb-4">
    <div class="card-body">
        @using (Html.BeginForm("Create", "BookingHeaders", FormMethod.Post, new { @class = "card-body" }))
        {
            <div class="card-title header-elements" style="margin-top:-20px">
                <h4 class="m-0 me-2">New Booking</h4>
                <div class="card-title-elements ms-auto">
                    <button type="button" class="btn btn-secondary me-sm-3 me-1" id="NewRoomBtn">Add New Room</button>
                    <button type="submit" class="btn btn-primary me-sm-3 me-1" id="SubmitBtn">Submit</button>
                    <button type="button" class="btn btn-warning" onClick="window.location.reload();">Clear</button>
                </div>
            </div>
            <hr class="my-4 mx-n4" />
            @Html.AntiForgeryToken()
            <div id="NewBookingsDiv">
                <div id="BookingDiv-1">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label" for="varBookingStartToEndDates1">Booking Period  <sup class="text-danger">*</sup></label>
                            @Html.EditorFor(model => model.varBookingStartToEndDates, new { htmlAttributes = new { @class = "form-control", @id = "varBookingStartToEndDates1", @type = "text", placeholder = "Booking Period...", autocomplete = "off", @required = "", @title = "Please Select Booking Period." } })
                            @Html.ValidationMessageFor(model => model.varBookingStartToEndDates, "", new { @class = "text-danger" })
                            @Html.EditorFor(model => model.dtFromDate, new { htmlAttributes = new { @id = "dtFromDate1", @style = "display:none" } })
                            @Html.EditorFor(model => model.dtToDate, new { htmlAttributes = new { @id = "dtToDate1", @style = "display:none" } })
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="numRoomTypeID1">Room Category  <sup class="text-danger">*</sup></label>
                            <select id="numRoomTypeID1" name="numRoomTypeID" required="" title="Please Select Room Category." onchange="LoadAvailableRooms(1)"></select>
                            @Html.ValidationMessageFor(model => model.numRoomTypeID, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="numRoomID1">Room No  <sup class="text-danger">*</sup></label>
                            <select id="numRoomID1" name="numRoomID" required="" title="Please Select Room." onchange="FillSelectedBookings(1)"></select>
                            @Html.ValidationMessageFor(model => model.numRoomID, "", new { @class = "text-danger", @id = "numRoomID1" })
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="form-check mt-3">
                                <input class="form-check-input" type="checkbox" value="true" id="bitStandardRate1" name="bitStandardRate" onclick="LoadCustomRateDiv(this,1)">
                                <label class="form-check-label form-label" for="bitStandardRate1">Custom Rate<sup class="text-danger">*</sup></label>
                            </div>
                            @Html.ValidationMessageFor(model => model.bitStandardRate, "", new { @class = "text-danger" })
                            <input type="hidden" name="bitStandardRateValue" id="bitStandardRateValue1" value="false" />
                        </div>
                        <div class="col-md-4" id="rateDiv1" style="margin-top: 33px; display: none;">
                            <label class="form-label" for="numRate1">Rate (€)  <sup class="text-danger">*</sup></label>
                            @Html.EditorFor(model => model.numRate, new { htmlAttributes = new { @class = "form-control", @id = "numRate1", @type = "number", placeholder = "Rate...", autocomplete = "off" } })
                            @Html.ValidationMessageFor(model => model.numRate, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="form-check mt-3">
                                <input class="form-check-input" type="checkbox" value="true" id="bitTransportRequired1" name="bitTransportRequired" onclick="LoadTransportDiv(this,1)">
                                <label class="form-check-label form-label" for="bitTransportRequired1">Transport Required<sup class="text-danger">*</sup></label>
                            </div>
                            @Html.ValidationMessageFor(model => model.bitTransportRequired, "", new { @class = "text-danger" })
                            <input type="hidden" name="bitTransportRequiredValue" id="bitTransportRequiredValue1" value="false" />
                        </div>
                        <div class="col-md-8" id="FlightDetailsDiv1" style="margin-top: 33px; display: none;">
                            <label class="form-label" for="varFlightDetails1">Flight Details <sup class="text-danger">*</sup></label>
                            @Html.EditorFor(model => model.varFlightDetails, new { htmlAttributes = new { @class = "form-control", @id = "varFlightDetails1", @type = "text", placeholder = "Description...", autocomplete = "off", cols = 100, @rows = 2 } })
                            @Html.ValidationMessageFor(model => model.varFlightDetails, "", new { @class = "text-danger", @id = "varFlightDetails1" })
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="form-check mt-3">
                                <input class="form-check-input" type="checkbox" value="true" id="bitKSLessonRequired1" name="bitKSLessonRequired" onclick="LoadLessonRequiredDiv(this,1)">
                                <label class="form-check-label form-label" for="bitKSLessonRequired1">Kite Surfing Lessons Required<sup class="text-danger">*</sup></label>
                            </div>
                            @Html.ValidationMessageFor(model => model.bitKSLessonRequired, "", new { @class = "text-danger" })
                            <input type="hidden" name="bitKSLessonRequiredValue" id="bitKSLessonRequiredValue1" value="false" />
                        </div>
                        <div class="col-md-4" id="KsLessonRequiredDiv1" style="margin-top: 33px; display: none;">
                            <label class="form-label" for="varKsLessonRequiredStartToEndDates1">Required Period  <sup class="text-danger">*</sup></label>
                            @Html.EditorFor(model => model.varKsLessonRequiredStartToEndDates, new { htmlAttributes = new { @class = "form-control", @id = "varKsLessonRequiredStartToEndDates1", @type = "text", placeholder = "Required Period...", autocomplete = "off", @required = "", @title = "Please Select Required Period." } })
                            @Html.ValidationMessageFor(model => model.varKsLessonRequiredStartToEndDates, "", new { @class = "text-danger" })
                            @Html.EditorFor(model => model.dtKsLessonRequiredFrom, new { htmlAttributes = new { @id = "dtKsLessonRequiredFrom1", @style = "display:none" } })
                            @Html.EditorFor(model => model.dtKsLessonRequiredTo, new { htmlAttributes = new { @id = "dtKsLessonRequiredTo1", @style = "display:none" } })
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="form-check mt-3">
                                <input class="form-check-input" type="checkbox" value="true" id="bitKSRentalRequired1" name="bitKSRentalRequired" onclick="LoadRentalRequiredDiv(this,1)">
                                <label class="form-check-label form-label" for="bitKSRentalRequired1">Kite Rental Required<sup class="text-danger">*</sup></label>
                            </div>
                            @Html.ValidationMessageFor(model => model.bitKSRentalRequired, "", new { @class = "text-danger" })
                            <input type="hidden" name="bitKSRentalRequiredValue" id="bitKSRentalRequiredValue1" value="false" />
                        </div>
                        <div class="col-md-4" id="KsRentalRequiredDiv1" style="margin-top: 33px; display: none;">
                            <label class="form-label" for="varKSRentalRequiredStartToEndDates1">Required Period  <sup class="text-danger">*</sup></label>
                            @Html.EditorFor(model => model.varKSRentalRequiredStartToEndDates, new { htmlAttributes = new { @class = "form-control", @id = "varKSRentalRequiredStartToEndDates1", @type = "text", placeholder = "Required Period...", autocomplete = "off", @required = "", @title = "Please Select Required Period." } })
                            @Html.ValidationMessageFor(model => model.varKSRentalRequiredStartToEndDates, "", new { @class = "text-danger" })
                            @Html.EditorFor(model => model.dtKSRentalRequiredFrom, new { htmlAttributes = new { @id = "dtKSRentalRequiredFrom1", @style = "display:none" } })
                            @Html.EditorFor(model => model.dtKSRentalRequiredTo, new { htmlAttributes = new { @id = "dtKSRentalRequiredTo1", @style = "display:none" } })
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="form-check mt-3">
                                <input class="form-check-input" type="checkbox" value="true" id="bitAgentRequired1" name="bitAgentRequired" onclick="LoadAgentRequiredDiv(this,1)">
                                <label class="form-check-label form-label" for="bitAgentRequired1">Booked Through Agent<sup class="text-danger">*</sup></label>
                            </div>
                            @Html.ValidationMessageFor(model => model.bitAgentRequired, "", new { @class = "text-danger" })
                            <input type="hidden" name="bitKSAgentRequiredValue" id="bitKSAgentRequiredValue1" value="false" />
                        </div>
                        <div class="col-md-5" id="KsAgentRequiredDiv1" style="margin-top: 33px; display: none;">
                            <label class="form-label" for="varAgentName1">Agent Name  <sup class="text-danger">*</sup></label>
                            @Html.EditorFor(model => model.varAgentName, new { htmlAttributes = new { @class = "form-control", @id = "varAgentName1", @type = "text", placeholder = "Name...", autocomplete = "off", @required = "", @title = "Please Enter Agent Name." } })
                            @Html.ValidationMessageFor(model => model.varAgentName, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label" for="varRemarks1">Remarks</label>
                            @Html.EditorFor(model => model.varRemarks, new { htmlAttributes = new { @class = "form-control", @id = "varRemarks1", @type = "text", placeholder = "Remarks...", autocomplete = "off", cols = 100, @rows = 2 } })
                            @Html.ValidationMessageFor(model => model.varRemarks, "", new { @class = "text-danger", @id = "varRemarks1" })
                        </div>
                    </div>
                    <br />
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label" for="varBookingPersonName">Booking Person Name  <sup class="text-danger">*</sup></label>
                            @Html.EditorFor(model => model.varBookingPersonName, new { htmlAttributes = new { @class = "form-control", @id = "varBookingPersonName", @type = "text", placeholder = "Person Name...", autocomplete = "off", @required = "", @title = "Please Enter Booking Person Name." } })
                            @Html.ValidationMessageFor(model => model.varBookingPersonName, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-5">
                            <label class="form-label" for="varBookingPersonEmail">Booking Person Email  <sup class="text-danger">*</sup></label>
                            @Html.EditorFor(model => model.varBookingPersonEmail, new { htmlAttributes = new { @class = "form-control", @id = "varBookingPersonEmail", @type = "text", placeholder = "Person Email...", autocomplete = "off", @required = "", @title = "Please Enter Booking Person Email." } })
                            @Html.ValidationMessageFor(model => model.varBookingPersonEmail, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <br />
                    <div class="row g-3">
                        <div class="col-md-12 table-responsive text-nowrap">
                            <table class="table table-bordered" id="HeadCountTbl1">
                                <thead>
                                    <tr>
                                        <th>No Of Adults<sup class="text-danger">*</sup></th>
                                        <th>No Of Children<sup class="text-danger">*</sup></th>
                                        <th>No Of Infants<sup class="text-danger">*</sup></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            @Html.EditorFor(model => model.numAdultsCount, new { htmlAttributes = new { @class = "form-control", @id = "numAdultsCount1", placeholder = "Adults Count...", autocomplete = "off", @required = "", @title = "Please Enter Adults Count.", @onkeyup = "CheckHeadCount(1);" } })
                                            @Html.ValidationMessageFor(model => model.numAdultsCount, "", new { @class = "text-danger" })
                                        </td>
                                        <td>
                                            @Html.EditorFor(model => model.numChildrensCount, new { htmlAttributes = new { @class = "form-control", @id = "numChildrensCount1", placeholder = "Children Count...", autocomplete = "off", @required = "", @title = "Please Enter Children Count.", @onkeyup = "CheckHeadCount(1);" } })
                                            @Html.ValidationMessageFor(model => model.numChildrensCount, "", new { @class = "text-danger" })
                                        </td>
                                        <td>
                                            @Html.EditorFor(model => model.numInfantsCount, new { htmlAttributes = new { @class = "form-control", @id = "numInfantsCount1", placeholder = "Infants Count...", autocomplete = "off", @required = "", @title = "Please Enter Infants Count.", @onkeyup = "CheckHeadCount(1);" } })
                                            @Html.ValidationMessageFor(model => model.numInfantsCount, "", new { @class = "text-danger" })
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <p class="text-danger" id="HeadCountErMsg1"></p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Assest/vendor/libs/select2/select2.js"></script>
<script src="~/Assest/vendor/libs/flatpickr/flatpickr.js"></script>
<script src="~/Assest/vendor/libs/toastr/toastr.js"></script>
<script type="text/javascript">
    document.getElementById("SubmitBtn").disabled = true;
    var Bookings = [];
    $("#numRoomTypeID1").select2({
        placeholder: "Select Room Category...",
    });
    $("#numRoomID1").select2({
        placeholder: "Select Room...",
    });
    flatpickr('#varBookingStartToEndDates1', {
        minDate: "today",
        mode: "range",
        onChange: function (selectedDates, dateStr, instance) {
            var StrDate = '';
            if (selectedDates[0] != undefined || selectedDates[0] != null) {
                StrDate = selectedDates[0].getFullYear() + "-" + (selectedDates[0].getMonth() + 1) + "-" + selectedDates[0].getDate();
                $("#dtFromDate1").val(StrDate);
            } else {
                $("#dtFromDate1").val('');
            }
            var EndDate = '';
            if (selectedDates[1] != undefined || selectedDates[1] != null) {
                EndDate = selectedDates[1].getFullYear() + "-" + (selectedDates[1].getMonth() + 1) + "-" + selectedDates[1].getDate();
                $("#dtToDate1").val(EndDate);
            } else {
                $("#dtToDate1").val('');
            }
            if (StrDate != '' && EndDate != '') {
                LoadRoomCategory(StrDate, EndDate, 1);
            }
        }
    });
    function LoadRoomCategory(StrDate, EndDate, R) {
        var SetBookings = {
            "dtFromDate": StrDate,
            "dtToDate": EndDate,
            "Bookings": JSON.stringify(Bookings)
        };
        $.ajax({
            type: "GET",
            traditional: true,
            async: false,
            cache: false,
            url: '@Url.Action("LoadRoomCategories", "BookingHeaders")',
            context: document.body,
            data: SetBookings,
            success: function (result) {
                var s = '<option value="">Select Room Category...</option>';
                for (var i = 0; i < result.length; i++) {
                    s += '<option value="' + result[i].id + '">' + result[i].name + '</option>';
                }
                $("#numRoomTypeID" + R).html(s);
            }
        });
    }
    function LoadAvailableRooms(R) {
        var RTid = $('#numRoomTypeID' + R + ' option:selected').val();
        var Dtfrom = document.getElementById('dtFromDate' + R).value;
        var DTend = document.getElementById('dtToDate' + R).value;
        if (RTid != null && Dtfrom != null && DTend != null) {
            var SetBookings = {
                "numRoomTypeID": RTid,
                "dtFromDate": Dtfrom,
                "dtToDate": DTend,
                "Bookings": JSON.stringify(Bookings)
            };
            $.ajax({
                type: "GET",
                traditional: true,
                async: false,
                cache: false,
                url: '@Url.Action("LoadAvailableRooms", "BookingHeaders")',
                context: document.body,
                data: SetBookings,
                success: function (result) {
                    var s = '<option value="">Select Room...</option>';
                    for (var i = 0; i < result.length; i++) {
                        s += '<option value="' + result[i].id + '">' + result[i].name + '</option>';
                    }
                    $("#numRoomID" + R).html(s);
                }
            });
        }
    }
    function FillSelectedBookings(R) {
        var Dtfrom = document.getElementById("dtFromDate" + R).value;
        var DTend = document.getElementById("dtToDate" + R).value;
        var RTid = $('#numRoomTypeID' + R + ' option:selected').val();
        var Rid = $('#numRoomID' + R + ' option:selected').val();
        $.ajax({
            type: 'GET',
            data: { numRoomID: Rid },
            url: '@Url.Action("LoadRoomPaxCount", "BookingHeaders")',
            success: function (result) {
                document.getElementById("numAdultsCount" + R).value = result;
                document.getElementById("numChildrensCount" + R).value = 0;
                document.getElementById("numInfantsCount" + R).value = 0;
                document.getElementById("SubmitBtn").disabled = false;
                if (RTid != null && Dtfrom != null && DTend != null) {
                    var booking = Bookings.find(x => x.numBookingID === R);
                    if (booking === undefined) {
                        var bookings = {};
                        bookings["numBookingID"] = R;
                        bookings["dtFromDate"] = Dtfrom;
                        bookings["dtToDate"] = DTend;
                        bookings["numRoomTypeID"] = RTid;
                        bookings["numRoomID"] = Rid;
                        bookings["numPaxCount"] = result;
                        Bookings.push(bookings);
                    } else {
                        const index = Bookings.findIndex(key => key.numBookingID === R);
                        Bookings.splice(index, 1);
                        var bookings = {};
                        bookings["numBookingID"] = R;
                        bookings["dtFromDate"] = Dtfrom;
                        bookings["dtToDate"] = DTend;
                        bookings["numRoomTypeID"] = RTid;
                        bookings["numRoomID"] = Rid;
                        bookings["numPaxCount"] = result;
                        Bookings.push(bookings);
                        CheckHeadCount(R);
                    }
                }
            }
        });
    }
    function CheckHeadCount(R) {
        var AdCount = Number(document.getElementById("numAdultsCount" + R).value);
        var ChCount = Number(document.getElementById("numChildrensCount" + R).value);
        var InfCount = Number(document.getElementById("numInfantsCount" + R).value);
        var tot = AdCount + ChCount + InfCount;
        var booking = Bookings.find(x => x.numBookingID === R);
        if (tot > booking.numPaxCount) {
            document.getElementById("HeadCountErMsg" + R).innerHTML = "Maximum Allowed Pax: " + booking.numPaxCount;
            document.getElementById("SubmitBtn").disabled = true;
        } else {
            document.getElementById("HeadCountErMsg" + R).innerHTML = "";
            document.getElementById("SubmitBtn").disabled = false;
        }
    }
    function LoadCustomRateDiv(k, i) {
        if (k.checked) {
            document.getElementById("rateDiv" + i).style.display = "block";
            document.getElementById("bitStandardRateValue" + i).value = true;
        }
        else {
            document.getElementById("rateDiv" + i).style.display = "none";
            document.getElementById("bitStandardRateValue" + i).value = false;
        }
    }
    function LoadTransportDiv(k, i) {
        if (k.checked) {
            document.getElementById("FlightDetailsDiv" + i).style.display = "block";
            document.getElementById("bitTransportRequiredValue" + i).value = true;
        }
        else {
            document.getElementById("FlightDetailsDiv" + i).style.display = "none";
            document.getElementById("bitTransportRequiredValue" + i).value = false;
        }
    }
    function LoadLessonRequiredDiv(k, i) {
        if (k.checked) {
            document.getElementById("KsLessonRequiredDiv" + i).style.display = "block";
            document.getElementById("bitKSLessonRequiredValue" + i).value = true;
        }
        else {
            document.getElementById("KsLessonRequiredDiv" + i).style.display = "none";
            document.getElementById("bitKSLessonRequiredValue" + i).value = false;
        }
    }
    flatpickr('#varKsLessonRequiredStartToEndDates1', {
        minDate: "today",
        mode: "range",
        onChange: function (selectedDates, dateStr, instance) {
            var StrDate = '';
            if (selectedDates[0] != undefined || selectedDates[0] != null) {
                StrDate = selectedDates[0].getFullYear() + "-" + (selectedDates[0].getMonth() + 1) + "-" + selectedDates[0].getDate();
                $("#dtKsLessonRequiredFrom1").val(StrDate);
            } else {
                $("#dtKsLessonRequiredFrom1").val('');
            }
            var EndDate = '';
            if (selectedDates[1] != undefined || selectedDates[1] != null) {
                EndDate = selectedDates[1].getFullYear() + "-" + (selectedDates[1].getMonth() + 1) + "-" + selectedDates[1].getDate();
                $("#dtKsLessonRequiredTo1").val(EndDate);
            } else {
                $("#dtKsLessonRequiredTo1").val('');
            }
        }
    });
    function LoadRentalRequiredDiv(k, i) {
        if (k.checked) {
            document.getElementById("KsRentalRequiredDiv" + i).style.display = "block";
            document.getElementById("bitKSRentalRequiredValue" + i).value = true;
        }
        else {
            document.getElementById("KsRentalRequiredDiv" + i).style.display = "none";
            document.getElementById("bitKSRentalRequiredValue" + i).value = false;
        }
    }
    function LoadAgentRequiredDiv(k, i) {
        if (k.checked) {
            document.getElementById("KsAgentRequiredDiv" + i).style.display = "block";
            document.getElementById("bitKSAgentRequiredValue" + i).value = true;
        }
        else {
            document.getElementById("KsAgentRequiredDiv" + i).style.display = "none";
            document.getElementById("bitKSAgentRequiredValue" + i).value = false;
        }
    }
    flatpickr('#varKSRentalRequiredStartToEndDates1', {
        minDate: "today",
        mode: "range",
        onChange: function (selectedDates, dateStr, instance) {
            var StrDate = '';
            if (selectedDates[0] != undefined || selectedDates[0] != null) {
                StrDate = selectedDates[0].getFullYear() + "-" + (selectedDates[0].getMonth() + 1) + "-" + selectedDates[0].getDate();
                $("#dtKSRentalRequiredFrom1").val(StrDate);
            } else {
                $("#dtKSRentalRequiredFrom1").val('');
            }
            var EndDate = '';
            if (selectedDates[1] != undefined || selectedDates[1] != null) {
                EndDate = selectedDates[1].getFullYear() + "-" + (selectedDates[1].getMonth() + 1) + "-" + selectedDates[1].getDate();
                $("#dtKSRentalRequiredTo1").val(EndDate);
            } else {
                $("#dtKSRentalRequiredTo1").val('');
            }
        }
    });
    var i = 1;
    $("#NewRoomBtn").click(function () {
        i++;
        var nextDiv = $(document.createElement('div')).attr("id", 'BookingDiv-' + i);
        nextDiv.after().html('<div class="row g-4"><div class="col-md-4"><label class="form-label" for="varBookingStartToEndDates' + i + '">Booking Period  <sup class="text-danger">*</sup></label><input autocomplete="off" class="form-control" id="varBookingStartToEndDates' + i + '" name="varBookingStartToEndDates" placeholder="Booking Period..." required="" title="Please Select Booking Period." type="text"><input id="dtFromDate' + i + '" name="dtFromDate" style="display:none"><input id="dtToDate' + i + '" name="dtToDate" style="display:none"></div>' +
                             '<div class="col-md-4"><label class="form-label" for="numRoomTypeID' + i + '">Room Category  <sup class="text-danger">*</sup></label><select id="numRoomTypeID' + i + '" name="numRoomTypeID" required="" title="Please Select Room Category." onchange="LoadAvailableRooms(' + i + ')"></select></div>' +
                             '<div class="col-md-4"><label class="form-label" for="numRoomID' + i + '">Room No  <sup class="text-danger">*</sup></label><select id="numRoomID' + i + '" name="numRoomID" required="" title="Please Select Room." onchange="FillSelectedBookings(' + i + ')"></select></div></div>' +
