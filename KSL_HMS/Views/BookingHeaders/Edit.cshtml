    function RemoveRooms(R)
    {
        var Rid = Number($('#numRoomID-' + R + ' option:selected').val());
        var booking = Bookings.find(x => x.numIndex === R);
        if (!isNaN(Rid) && booking.numRoomID == Rid) {
            RemovedBookings.push(booking.numBookingID);
        }
        //console.log(RemovedBookings);

        $("#BookingDiv-" + R).remove();
        const index = Bookings.findIndex(e => e.numIndex === R);
        if (index > -1) {
            Bookings.splice(index, 1);
        }
        //console.log(Bookings);
    }
