@model IEnumerable<KSL_HMS.DB.BookingHeader>

@{
    ViewBag.NewInternalBooking = "active open";
    ViewBag.Booking = "active open";
    ViewBag.NewBooking = "active";
    ViewBag.Title = "Update Booking";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int i = 1;
    int MainBooking = Model.Count();
}
<link href="~/Assest/vendor/libs/toastr/toastr.css" rel="stylesheet" />
<link href="~/Assest/vendor/libs/flatpickr/flatpickr.css" rel="stylesheet" />
<link href="~/Assest/vendor/libs/select2/select2.css" rel="stylesheet" />

<div class="card mb-4">
    <div class="card-body">
        @using (Html.BeginForm("Edit", "BookingHeaders", FormMethod.Post, new { @class = "card-body" }))
        {
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="card-title header-elements" style="margin-top:-20px">
                <h4 class="m-0 me-2">Update Booking</h4>
                <div class="card-title-elements ms-auto">
                    <button type="button" class="btn btn-secondary me-sm-3 me-1" id="NewRoomBtn">Add New Room</button>
                    <button type="submit" class="btn btn-primary me-sm-3 me-1" id="SubmitBtn">Submit</button>
                    <button type="button" class="btn btn-warning" onClick="window.location.reload();">Clear</button>
                </div>
            </div>
            <hr class="my-4 mx-n4" />
            @Html.AntiForgeryToken()
            <input type="hidden" name="numBookingRefferenceID" id="numBookingRefferenceID" value="@TempData["numBookingRefferenceID"]" />
            <div id="NewBookingsDiv">
                @foreach (var item in Model)
                {
                    <div id="BookingDiv-@i">@item.numBookingHeaderID
                        <input type="text" name="numBookingHeaderID" id="numBookingHeaderID-@i" value="@item.numBookingHeaderID" style="display:none" />
                        <div class="row g-4">
                            <div class="col-md-4">
                                <label class="form-label" for="varBookingStartToEndDates-@i">Booking Period  <sup class="text-danger">*</sup></label>
                                <input type="text" class="form-control" name="varBookingStartToEndDates" id="varBookingStartToEndDates-@i" placeholder="Booking Period..." required="" title="Please Select Booking Period." disabled />
                                @Html.ValidationMessageFor(model => item.varBookingStartToEndDates, "", new { @class = "text-danger" })
                                <input id="dtFromDate-@i" name="dtFromDate" style="display:none" value="@item.dtFromDate.Value.ToString("yyyy-MM-dd")">
                                <input id="dtToDate-@i" name="dtToDate" style="display:none" value="@item.dtToDate.Value.ToString("yyyy-MM-dd")">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="numRoomTypeID-@i">Room Category  <sup class="text-danger">*</sup></label>
                                <select id="numRoomTypeID-@i" required="" title="Please Select Room Category." onchange="LoadNonBookingAvailableRooms(@i)" disabled></select>
                                <input type="hidden" name="numRoomTypeID" value="@item.numRoomTypeID" />
                                @Html.ValidationMessageFor(model => item.numRoomTypeID, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="numRoomID-@i">Room No  <sup class="text-danger">*</sup></label>
                                <select id="numRoomID-@i" required="" title="Please Select Room." onchange="FillSelectedBookings(@i)" disabled></select>
                                <input type="hidden" name="numRoomID" value="@item.numRoomID" />
                                @Html.ValidationMessageFor(model => item.numRoomID, "", new { @class = "text-danger", @id = "numRoomID-" + i })
                            </div>
                        </div>
                        @if (item.bitStandardRate == false)
                        {
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <div class="form-check mt-3">
                                        <input class="form-check-input" type="checkbox" value="true" id="bitStandardRate-@i" name="bitStandardRate" onclick="LoadCustomRateDiv(this,@i)">
                                        <label class="form-check-label form-label" for="bitStandardRate-@i">Custom Rate<sup class="text-danger">*</sup></label>
                                    </div>
                                    @Html.ValidationMessageFor(model => item.bitStandardRate, "", new { @class = "text-danger" })
                                    <input type="hidden" name="bitStandardRateValue" id="bitStandardRateValue-@i" value="false" />
                                </div>
                                <div class="col-md-4" id="rateDiv-@i" style="margin-top: 33px; display: none;">
                                    <label class="form-label" for="numRate-@i">Rate (€)  <sup class="text-danger">*</sup></label>
                                    <input autocomplete="off" class="form-control" id="numRate-@i" name="numRate" placeholder="Rate..." type="number" value="@item.numRate">
                                    @Html.ValidationMessageFor(model => item.numRate, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <div class="form-check mt-3">
                                        <input class="form-check-input" type="checkbox" value="true" id="bitStandardRate-@i" name="bitStandardRate" onclick="LoadCustomRateDiv(this,@i)" checked="checked">
                                        <label class="form-check-label form-label" for="bitStandardRate-@i">Custom Rate<sup class="text-danger">*</sup></label>
                                    </div>
                                    @Html.ValidationMessageFor(model => item.bitStandardRate, "", new { @class = "text-danger" })
                                    <input type="hidden" name="bitStandardRateValue" id="bitStandardRateValue-@i" value="true" />
                                </div>
                                <div class="col-md-4" id="rateDiv-@i" style="margin-top: 33px; display: block;">
                                    <label class="form-label" for="numRate-@i">Rate (€)  <sup class="text-danger">*</sup></label>
                                    <input autocomplete="off" class="form-control" id="numRate-@i" name="numRate" placeholder="Rate..." type="number" value="@item.numRate">
                                    @Html.ValidationMessageFor(model => item.numRate, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        }
                        @if (item.bitTransportRequired == false)
                        {
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <div class="form-check mt-3">
                                        <input class="form-check-input" type="checkbox" value="true" id="bitTransportRequired-@i" name="bitTransportRequired" onclick="LoadTransportDiv(this,@i)">
                                        <label class="form-check-label form-label" for="bitTransportRequired-@i">Transport Required<sup class="text-danger">*</sup></label>
                                    </div>
                                    @Html.ValidationMessageFor(model => item.bitTransportRequired, "", new { @class = "text-danger" })
                                    <input type="hidden" name="bitTransportRequiredValue" id="bitTransportRequiredValue-@i" value="false" />
                                </div>
                                <div class="col-md-8" id="FlightDetailsDiv-@i" style="margin-top: 33px; display: none;">
                                    <label class="form-label" for="varFlightDetails-@i">Flight Details <sup class="text-danger">*</sup></label>
                                    <textarea autocomplete="off" class="form-control" cols="100" id="varFlightDetails-@i" name="varFlightDetails" placeholder="Description..." rows="2" type="text"></textarea>
                                    @Html.ValidationMessageFor(model => item.varFlightDetails, "", new { @class = "text-danger", @id = "varFlightDetails-" + i })
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <div class="form-check mt-3">
                                        <input class="form-check-input" type="checkbox" value="true" id="bitTransportRequired-@i" name="bitTransportRequired" onclick="LoadTransportDiv(this,@i)" checked="checked">
                                        <label class="form-check-label form-label" for="bitTransportRequired-@i">Transport Required<sup class="text-danger">*</sup></label>
                                    </div>
                                    @Html.ValidationMessageFor(model => item.bitTransportRequired, "", new { @class = "text-danger" })
                                    <input type="hidden" name="bitTransportRequiredValue" id="bitTransportRequiredValue-@i" value="true" />
                                </div>
                                <div class="col-md-8" id="FlightDetailsDiv-@i" style="margin-top: 33px; display: block;">
                                    <label class="form-label" for="varFlightDetails-@i">Flight Details <sup class="text-danger">*</sup></label>
                                    <textarea autocomplete="off" class="form-control" cols="100" id="varFlightDetails-@i" name="varFlightDetails" placeholder="Description..." rows="2" type="text">@item.varFlightDetails</textarea>
                                    @Html.ValidationMessageFor(model => item.varFlightDetails, "", new { @class = "text-danger", @id = "varFlightDetails-" + i })
                                </div>
                            </div>
                        }
                        @if (item.bitKSLessonRequired == false)
                        {
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <div class="form-check mt-3">
                                        <input class="form-check-input" type="checkbox" value="true" id="bitKSLessonRequired-@i" name="bitKSLessonRequired" onclick="LoadLessonRequiredDiv(this,@i)">
                                        <label class="form-check-label form-label" for="bitKSLessonRequired-@i">Kite Surfing Lessons Required<sup class="text-danger">*</sup></label>
                                    </div>
                                    @Html.ValidationMessageFor(model => item.bitKSLessonRequired, "", new { @class = "text-danger" })
                                    <input type="hidden" name="bitKSLessonRequiredValue" id="bitKSLessonRequiredValue-@i" value="false" />
                                </div>
                                <div class="col-md-4" id="KsLessonRequiredDiv-@i" style="margin-top: 33px; display: none;">
                                    <label class="form-label" for="varKsLessonRequiredStartToEndDates-@i">Required Period  <sup class="text-danger">*</sup></label>
                                    @Html.EditorFor(model => item.varKsLessonRequiredStartToEndDates, new { htmlAttributes = new { @class = "form-control", @id = "varKsLessonRequiredStartToEndDates-" + i, @type = "text", placeholder = "Required Period...", autocomplete = "off", @required = "", @title = "Please Select Required Period." } })
                                    @Html.ValidationMessageFor(model => item.varKsLessonRequiredStartToEndDates, "", new { @class = "text-danger" })
                                    <input id="dtKsLessonRequiredFrom-@i" name="dtKsLessonRequiredFrom" style="display:none" value="@item.dtKsLessonRequiredFrom">
                                    <input id="dtKsLessonRequiredTo-@i" name="dtKsLessonRequiredTo" style="display:none" value="@item.dtKsLessonRequiredTo">
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <div class="form-check mt-3">
                                        <input class="form-check-input" type="checkbox" value="true" id="bitKSLessonRequired-@i" name="bitKSLessonRequired" onclick="LoadLessonRequiredDiv(this,@i)" checked="checked">
                                        <label class="form-check-label form-label" for="bitKSLessonRequired-@i">Kite Surfing Lessons Required<sup class="text-danger">*</sup></label>
                                    </div>
                                    @Html.ValidationMessageFor(model => item.bitKSLessonRequired, "", new { @class = "text-danger" })
                                    <input type="hidden" name="bitKSLessonRequiredValue" id="bitKSLessonRequiredValue-@i" value="true" />
                                </div>
                                <div class="col-md-4" id="KsLessonRequiredDiv-@i" style="margin-top: 33px; display: block;">
                                    <label class="form-label" for="varKsLessonRequiredStartToEndDates-@i">Required Period  <sup class="text-danger">*</sup></label>
                                    @Html.EditorFor(model => item.varKsLessonRequiredStartToEndDates, new { htmlAttributes = new { @class = "form-control", @id = "varKsLessonRequiredStartToEndDates-" + i, @type = "text", placeholder = "Required Period...", autocomplete = "off", @required = "", @title = "Please Select Required Period." } })
                                    @Html.ValidationMessageFor(model => item.varKsLessonRequiredStartToEndDates, "", new { @class = "text-danger" })
                                    <input id="dtKsLessonRequiredFrom-@i" name="dtKsLessonRequiredFrom" style="display:none" value="@item.dtKsLessonRequiredFrom">
                                    <input id="dtKsLessonRequiredTo-@i" name="dtKsLessonRequiredTo" style="display:none" value="@item.dtKsLessonRequiredTo">
                                </div>
                            </div>
                        }
                        @if (item.bitKSRentalRequired == false)
                        {
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <div class="form-check mt-3">
                                        <input class="form-check-input" type="checkbox" value="true" id="bitKSRentalRequired-@i" name="bitKSRentalRequired" onclick="LoadRentalRequiredDiv(this,@i)">
                                        <label class="form-check-label form-label" for="bitKSRentalRequired-@i">Kite Rental Required<sup class="text-danger">*</sup></label>
                                    </div>
                                    @Html.ValidationMessageFor(model => item.bitKSRentalRequired, "", new { @class = "text-danger" })
                                    <input type="hidden" name="bitKSRentalRequiredValue" id="bitKSRentalRequiredValue-@i" value="false" />
                                </div>
                                <div class="col-md-4" id="KsRentalRequiredDiv-@i" style="margin-top: 33px; display: none;">
                                    <label class="form-label" for="varKSRentalRequiredStartToEndDates-@i">Required Period  <sup class="text-danger">*</sup></label>
                                    @Html.EditorFor(model => item.varKSRentalRequiredStartToEndDates, new { htmlAttributes = new { @class = "form-control", @id = "varKSRentalRequiredStartToEndDates-" + i, @type = "text", placeholder = "Required Period...", autocomplete = "off", @required = "", @title = "Please Select Required Period." } })
                                    @Html.ValidationMessageFor(model => item.varKSRentalRequiredStartToEndDates, "", new { @class = "text-danger" })
                                    <input id="dtKSRentalRequiredFrom-@i" name="dtKSRentalRequiredFrom" style="display:none" value="@item.dtKSRentalRequiredFrom">
                                    <input id="dtKSRentalRequiredTo-@i" name="dtKSRentalRequiredTo" style="display:none" value="@item.dtKSRentalRequiredTo">
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <div class="form-check mt-3">
                                        <input class="form-check-input" type="checkbox" value="true" id="bitKSRentalRequired-@i" name="bitKSRentalRequired" onclick="LoadRentalRequiredDiv(this,@i)" checked="checked">
                                        <label class="form-check-label form-label" for="bitKSRentalRequired-@i">Kite Rental Required<sup class="text-danger">*</sup></label>
                                    </div>
                                    @Html.ValidationMessageFor(model => item.bitKSRentalRequired, "", new { @class = "text-danger" })
                                    <input type="hidden" name="bitKSRentalRequiredValue" id="bitKSRentalRequiredValue-@i" value="true" />
                                </div>
                                <div class="col-md-4" id="KsRentalRequiredDiv-@i" style="margin-top: 33px; display: block;">
                                    <label class="form-label" for="varKSRentalRequiredStartToEndDates-@i">Required Period  <sup class="text-danger">*</sup></label>
                                    @Html.EditorFor(model => item.varKSRentalRequiredStartToEndDates, new { htmlAttributes = new { @class = "form-control", @id = "varKSRentalRequiredStartToEndDates-" + i, @type = "text", placeholder = "Required Period...", autocomplete = "off", @required = "", @title = "Please Select Required Period." } })
                                    @Html.ValidationMessageFor(model => item.varKSRentalRequiredStartToEndDates, "", new { @class = "text-danger" })
                                    <input id="dtKSRentalRequiredFrom-@i" name="dtKSRentalRequiredFrom" style="display:none" value="@item.dtKSRentalRequiredFrom">
                                    <input id="dtKSRentalRequiredTo-@i" name="dtKSRentalRequiredTo" style="display:none" value="@item.dtKSRentalRequiredTo">
                                </div>
                            </div>
                        }
                        @if (item.bitAgentRequired == false)
                        {
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <div class="form-check mt-3">
                                        <input class="form-check-input" type="checkbox" value="true" id="bitAgentRequired-@i" name="bitAgentRequired" onclick="LoadAgentRequiredDiv(this,@i)">
                                        <label class="form-check-label form-label" for="bitAgentRequired-@i">Booked Through Agent<sup class="text-danger">*</sup></label>
                                    </div>
                                    @Html.ValidationMessageFor(model => item.bitAgentRequired, "", new { @class = "text-danger" })
                                    <input type="hidden" name="bitKSAgentRequiredValue" id="bitKSAgentRequiredValue-@i" value="false" />
                                </div>
                                <div class="col-md-5" id="KsAgentRequiredDiv-@i" style="margin-top: 33px; display: none;">
                                    <label class="form-label" for="varAgentName-@i">Agent Name  <sup class="text-danger">*</sup></label>
                                    <input autocomplete="off" class="form-control" id="varAgentName-@i" name="varAgentName" placeholder="Name..." type="text" value="@item.varAgentName">
                                    @Html.ValidationMessageFor(model => item.varAgentName, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <div class="form-check mt-3">
                                        <input class="form-check-input" type="checkbox" value="true" id="bitAgentRequired-@i" name="bitAgentRequired" onclick="LoadAgentRequiredDiv(this,@i)" checked="checked">
                                        <label class="form-check-label form-label" for="bitAgentRequired-@i">Booked Through Agent<sup class="text-danger">*</sup></label>
                                    </div>
                                    @Html.ValidationMessageFor(model => item.bitAgentRequired, "", new { @class = "text-danger" })
                                    <input type="hidden" name="bitKSAgentRequiredValue" id="bitKSAgentRequiredValue-@i" value="true" />
                                </div>
                                <div class="col-md-5" id="KsAgentRequiredDiv-@i" style="margin-top: 33px; display: block;">
                                    <label class="form-label" for="varAgentName-@i">Agent Name  <sup class="text-danger">*</sup></label>
                                    <input autocomplete="off" class="form-control" id="varAgentName-@i" name="varAgentName" placeholder="Name..." type="text" value="@item.varAgentName">
                                    @Html.ValidationMessageFor(model => item.varAgentName, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        }
                        <div class="row g-3">
                            <div class="col-md-7">
                                <label class="form-label" for="varRemarks-@i">Remarks</label>
                                <textarea autocomplete="off" class="form-control" cols="100" id="varRemarks-@i" name="varRemarks" placeholder="Remarks..." rows="2" type="text">@item.varRemarks</textarea>
                                @Html.ValidationMessageFor(model => item.varRemarks, "", new { @class = "text-danger", @id = "varRemarks-" + i })
                            </div>
                        </div>
                        @if (i == MainBooking)
                        {
                            <br />
                            <div class="row g-3">
                                <div class="col-md-5">
                                    <label class="form-label" for="varBookingPersonName">Booking Person Name  <sup class="text-danger">*</sup></label>
                                    @Html.EditorFor(model => item.varBookingPersonName, new { htmlAttributes = new { @class = "form-control", @id = "varBookingPersonName", @type = "text", placeholder = "Person Name...", autocomplete = "off", @required = "", @title = "Please Enter Booking Person Name." } })
                                    @Html.ValidationMessageFor(model => item.varBookingPersonName, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label" for="varBookingPersonEmail">Booking Person Email  <sup class="text-danger">*</sup></label>
                                    @Html.EditorFor(model => item.varBookingPersonEmail, new { htmlAttributes = new { @class = "form-control", @id = "varBookingPersonEmail", @type = "text", placeholder = "Person Email...", autocomplete = "off", @required = "", @title = "Please Enter Booking Person Email." } })
                                    @Html.ValidationMessageFor(model => item.varBookingPersonEmail, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        }
                        <br />
                        <div class="row g-3">
                            <div class="col-md-12 table-responsive text-nowrap">
                                <table class="table table-bordered" id="HeadCountTbl-@i">
                                    <thead>
                                        <tr>
                                            <th>No Of Adults<sup class="text-danger">*</sup></th>
                                            <th>No Of Children<sup class="text-danger">*</sup></th>
                                            <th>No Of Infants<sup class="text-danger">*</sup></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>
                                                <input onkeyup="CheckHeadCount(@i)" autocomplete="off" class="form-control" id="numAdultsCount-@i" name="numAdultsCount" placeholder="Adults Count..." type="number" value="@item.numAdultsCount" required="" title="Please Enter Adults Count.">
                                                @Html.ValidationMessageFor(model => item.numAdultsCount, "", new { @class = "text-danger" })
                                            </td>
                                            <td>
                                                <input onkeyup="CheckHeadCount(@i)" autocomplete="off" class="form-control" id="numChildrensCount-@i" name="numChildrensCount" placeholder="Children Count..." type="number" value="@item.numChildrensCount" required="" title="Please Enter Children Count.">
                                                @Html.ValidationMessageFor(model => item.numChildrensCount, "", new { @class = "text-danger" })
                                            </td>
                                            <td>
                                                <input onkeyup="CheckHeadCount(@i)" autocomplete="off" class="form-control" id="numInfantsCount-@i" name="numInfantsCount" placeholder="Infants Count..." type="number" value="@item.numInfantsCount" required="" title="Please Enter Infants Count.">
                                                @Html.ValidationMessageFor(model => item.numInfantsCount, "", new { @class = "text-danger" })
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <p class="text-danger" id="HeadCountErMsg-@i"></p>
                            </div>
                        </div>
                        @*@if (i != MainBooking)
                        {
                            <br />
                            <div class="row justify-content-md-end">
                                <button type="button" class="btn rounded-pill btn-icon btn-danger" onclick="RemoveRooms(@i)">
                                    <span class="tf-icons bx bx-trash"></span>
                                </button>
                            </div>
                            <hr class="my-4 mx-n4" />
                            <br />
                        }*@
                    </div>
                    i++;
                }
            </div>
        }
    </div>
</div>
<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Assest/vendor/libs/select2/select2.js"></script>
<script src="~/Assest/vendor/libs/flatpickr/flatpickr.js"></script>
<script src="~/Assest/vendor/libs/toastr/toastr.js"></script>
<script type="text/javascript">
    let RemovedBookings = [];
    let Bookings = @Html.Raw(Json.Encode(TempData["Bookings"]));
    let z = @i - 1;
    for (var j = 1; j <= z; j++) {
        let numBookingHeaderID = document.getElementById('numBookingHeaderID-' + j).value
        var booking = Bookings.find(x => x.numBookingID == numBookingHeaderID);
        if (booking != undefined) {
            flatpickr('#varBookingStartToEndDates-' + j, {
                minDate: booking.dtFromDate,
                mode: "range",
                defaultDate: [booking.dtFromDate, booking.dtToDate],
                onChange: function (selectedDates, dateStr, instance)
                {
                    let input = instance.input.id;
                    let myArray = input.split("-");
                    let id = myArray[1];

                    var StrDate = '';
                    if (selectedDates[0] != undefined || selectedDates[0] != null) {
                        StrDate = selectedDates[0].getFullYear() + "-" + (selectedDates[0].getMonth() + 1) + "-" + selectedDates[0].getDate();
                        $("#dtFromDate-" + id).val(StrDate);
                    } else {
                        $("#dtFromDate-" + id).val('');
                    }
                    var EndDate = '';
                    if (selectedDates[1] != undefined || selectedDates[1] != null) {
                        EndDate = selectedDates[1].getFullYear() + "-" + (selectedDates[1].getMonth() + 1) + "-" + selectedDates[1].getDate();
                        $("#dtToDate-" + id).val(EndDate);
                    } else {
                        $("#dtToDate-" + id).val('');
                    }
                    if (StrDate != '' && EndDate != '') {
                        LoadNonBookingRoomCategory(numBookingHeaderID,StrDate, EndDate, id);
                    }
                }
            });
            $.ajax({
                type: 'GET',
                traditional: true,
                async: false,
                cache: false,
                data: { numBokingID: booking.numBookingID, numRoomTypeID: booking.numRoomTypeID, dtFromDate: booking.dtFromDate, dtToDate: booking.dtToDate },
                url: '@Url.Action("LoadEditRoomCategories", "BookingHeaders")',
                success: function (result)
                {
                    var s = '<option value="' + result.roomId + '">' + result.roomName + '</option>';
                    for (var i = 0; i < result.rooms.length; i++) {
                        s += '<option value="' + result.rooms[i].id + '">' + result.rooms[i].name + '</option>';
                    }
                    $("#numRoomTypeID-" + j).html(s);
                }
            });
            $("#numRoomTypeID-" + j).select2({
                placeholder: "Select Room Category...",
            });
            $.ajax({
                type: 'GET',
