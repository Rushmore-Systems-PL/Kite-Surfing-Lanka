@model IEnumerable<KSL_HMS.Models.BookingHeaderDTO>

@{
    ViewBag.Bookings = "active";
    ViewBag.Title = "Booking Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Assest/vendor/libs/datatables-bs5/datatables.bootstrap5.css" rel="stylesheet" />
<link href="~/Assest/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" rel="stylesheet" />
<link href="~/Assest/vendor/libs/toastr/toastr.css" rel="stylesheet" />
<link href="~/Assest/vendor/libs/animate-css/animate.css" rel="stylesheet" />

<div class="card">
    <div class="card-body">
        <h4>Booking Master</h4>
        <hr class="my-4 mx-n4" />
        <table class="datatables-basic table border-top" id="MasterTable">
            <thead>
                <tr>
                    <th class="text-center">#</th>
                    <th>Reference</th>
                    <th>Room</th>
                    <th>Booking Period</th>
                    <th>Guests</th>
                    <th class="text-center">Status</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int i = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center" width="2px">
                                .@i.ToString("00")
                            </td>
                            <td>
                                @item.varBookingRefferenceNo
                            </td>
                            <td>
                                @item.varRoomTypeName | @item.varRoomNo
                            </td>
                            <td>
                                @item.dtFromDate.Value.ToString("MMM dd") - @item.dtToDate.Value.ToString("MMM dd")
                            </td>
                            <td>
                                @item.numGuestCount.Value.ToString("00")
                            </td>
                            <td class="text-center">
                                @if (item.bitClosed == true)
                                {
                                    <span class="badge bg-label-danger">Closed</span>
                                }
                                else if (item.bitCheckedOut == true)
                                {
                                    <span class="badge bg-label-warning">Checked-Out</span>
                                }
                                else if (item.bitCheckedIn == true)
                                {
                                    <span class="badge bg-label-success">Checked-In</span>
                                }
                                else
                                {
                                    <span class="badge bg-label-info">Reserved</span>
                                }
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-icon me-2" onclick="LoadBookings(@item.numBookingHeaderID)"><i class="bx bx-info-circle text-info"></i></button>

                                @if (item.bitCheckedIn == false)
                                {
                                    <span class="text-nowrap">
                                        <a class="btn btn-sm btn-icon edit-record" onclick="location.href='@Url.Action("Edit", "BookingHeaders")/'+@item.numBookingRefferenceID"><i class="bx bx-edit text-warning"></i></a>
                                    </span>
                                    <span class="text-nowrap">
                                        <button class="btn btn-sm btn-icon delete-record" onclick="SetItemsID(@item.numBookingHeaderID)"><i class="bx bx-trash text-danger"></i></button>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-nowrap">
                                        <button class="btn btn-sm btn-icon delete-record" onclick="javascript:void(0);" disabled><i class="bx bx-edit text-warning"></i></button>
                                    </span>
                                    <span class="text-nowrap">
                                        <button class="btn btn-sm btn-icon delete-record" onclick="javascript:void(0);" disabled><i class="bx bx-trash text-danger"></i></button>
                                    </span>
                                }
                            </td>
                        </tr>
                        i++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="col-lg-3 col-md-6">
    <div class="mt-3">
        <div class="offcanvas offcanvas-bottom" data-bs-backdrop="false" tabindex="-1" id="BooingDeleteCanvas" aria-labelledby="BooingDeleteCanvasLabel">
            <div class="offcanvas-header">
                <h4 id="BooingDeleteCanvasLabel" class="offcanvas-title">Booking</h4>
                <button type="button" class="btn-close text-reset" onclick="CancelItems()" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                <h5>Are You Sure?</h5>
                <p style="margin-top:-10px">Do You Want To Delete This Booking...!</p>
                <button type="button" class="btn btn-primary me-2" onclick="DeleteItems()">Continue</button>
                <button type="button" class="btn btn-warning" onclick="CancelItems()">Cancel</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="BookingModal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="BookingModalDiv" style="margin-top:-20px"></div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Assest/vendor/libs/datatables/jquery.dataTables.js"></script>
<script src="~/Assest/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
<script src="~/Assest/vendor/libs/datatables-responsive/datatables.responsive.js"></script>
<script src="~/Assest/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.js"></script>
<script src="~/Assest/vendor/libs/toastr/toastr.js"></script>
<script type="text/javascript">
    var numBookingHeaderID = 0;
    $(function myfunction() {
        var Msg = '@TempData["BookingConfirmationStatus"]'
        if (Msg != '') {
            if (Msg == "Saved") {
                toastr.options = {
                    "closeButton": true,
                    "debug": false,
                    "newestOnTop": true,
                    "progressBar": true,
                    "positionClass": "toast-top-right",
                    "preventDuplicates": false,
                    "onclick": null,
                    "showDuration": "300",
                    "hideDuration": "1000",
                    "timeOut": "5000",
                    "extendedTimeOut": "1000",
                    "showEasing": "swing",
                    "hideEasing": "linear",
                };
                toastr["success"]("Booking Created Successfully.", " Success");
            }
        }
        var Msg2= '@TempData["CheckOutConfirmationStatus"]'
        if (Msg2 != '') {
            if (Msg2 == "Saved") {
                toastr.options = {
                    "closeButton": true,
                    "debug": false,
                    "newestOnTop": true,
                    "progressBar": true,
                    "positionClass": "toast-top-right",
                    "preventDuplicates": false,
                    "onclick": null,
                    "showDuration": "300",
                    "hideDuration": "1000",
                    "timeOut": "5000",
                    "extendedTimeOut": "1000",
                    "showEasing": "swing",
                    "hideEasing": "linear",
                };
                toastr["success"]("Check-Out Confirmed Successfully.", " Success");
            }
        }
        var Msg3 = '@TempData["BookingStatus"]'
        if (Msg3 == "DeActivate") {
            toastr.options = {
                "closeButton": true,
                "debug": false,
                "newestOnTop": true,
                "progressBar": true,
                "positionClass": "toast-top-right",
                "preventDuplicates": false,
                "onclick": null,
                "showDuration": "300",
                "hideDuration": "1000",
                "timeOut": "5000",
                "extendedTimeOut": "1000",
                "showEasing": "swing",
                "hideEasing": "linear",
            };
            toastr["error"]("Booking Deleted Successfully.", " Success");
        }
    })
    function SetItemsID(id) {
        numBookingHeaderID = id;
        $('#BooingDeleteCanvas').offcanvas('show');
    }
    function CancelItems() {
        numBookingHeaderID = 0;
        $('#BooingDeleteCanvas').offcanvas('hide');
    }
    function DeleteItems() {
        $.ajax({
            type: "POST",
            url: '@Url.Action("DeActive", "BookingHeaders")/' + numBookingHeaderID
        });
        location.reload();
    }
    $(function myfunction() {
        var Msg = '@TempData["BookingStatus"]'
        if (Msg != '') {
            if (Msg == "Deleted") {
                toastr.options = {
                    "closeButton": true,
                    "debug": false,
                    "newestOnTop": true,
                    "progressBar": true,
                    "positionClass": "toast-top-right",
                    "preventDuplicates": false,
                    "onclick": null,
                    "showDuration": "300",
                    "hideDuration": "1000",
                    "timeOut": "5000",
                    "extendedTimeOut": "1000",
                    "showEasing": "swing",
                    "hideEasing": "linear",
                };
                toastr["warning"]("Booking Canceled Successfully.", " Success");
            }
        }
    })
    var table = $('#MasterTable').DataTable({
        scrollY: true,
        scrollX: true,
        scrollCollapse: true,
        paging: true,
        fixedColumns: false
    });
    function LoadBookings(id) {
        $.ajax({
            type: 'GET',
            data: { id: id },
            url: '@Url.Action("BookingCalenderDetails", "BookingHeaders")',
            success: function (response) {
                $("#BookingModalDiv").html(response);
                $('#BookingModal').modal('show');
            }
        });
    }
</script>