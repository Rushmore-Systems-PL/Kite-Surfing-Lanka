    </div>
</div>
<br />
<div class="card">
    <div class="card-body">
        <h4>Check-Out Confirmation</h4>
        <div class="row">
            <p style="margin-top:-10px">Please check booking details and booking guest details before confirm...</p>
        </div>
        <div class="pt-4">
            <button type="button" class="btn btn-primary me-sm-3 me-1" onclick="checkOutBooking(@ViewBag.numBookingHeaderID)">Confirm</button>
            <button type="button" class="btn btn-warning" onClick="window.location.reload();">Cancel</button>
        </div>
    </div>
</div>