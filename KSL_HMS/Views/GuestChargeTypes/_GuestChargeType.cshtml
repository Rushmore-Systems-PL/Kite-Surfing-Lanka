@model KSL_HMS.DB.GuestChargeType

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.numGuestChargeTypeID)
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label" for="varGuestChargeTypeName">Guest Charge Category Name  <sup class="text-danger">*</sup></label>
            @Html.EditorFor(model => model.varGuestChargeTypeName, new { htmlAttributes = new { @class = "form-control", @id = "varGuestChargeTypeName", @type = "text", placeholder = "Category Name...", autocomplete = "off" } })
            @Html.ValidationMessageFor(model => model.varGuestChargeTypeName, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-4">
            <label class="form-label" for="numChargeTypeDiscount">Guest Charge Discount Percentage (%)  <sup class="text-danger">*</sup></label>
            @Html.EditorFor(model => model.numChargeTypeDiscount, new { htmlAttributes = new { @class = "form-control", @id = "numChargeTypeDiscount", @type = "number", placeholder = "Discount Percentage...", autocomplete = "off" } })
            @Html.ValidationMessageFor(model => model.numChargeTypeDiscount, "", new { @class = "text-danger" })
        </div>
    </div>
    <br />
    <div class="row g-3">
        <div class="col-md-8">
            <label class="form-label" for="varGuestChargeTypeDescription">Guest Charge Category Description</label>
            @Html.EditorFor(model => model.varGuestChargeTypeDescription, new { htmlAttributes = new { @class = "form-control", @id = "varGuestChargeTypeDescription", @type = "text", placeholder = "Description...", autocomplete = "off", cols = 100, @rows = 3 } })
            @Html.ValidationMessageFor(model => model.varGuestChargeTypeDescription, "", new { @class = "text-danger", @id = "varGuestChargeTypeDescription" })
        </div>
    </div>
    @Html.HiddenFor(model => model.bitActive)
    @Html.HiddenFor(model => model.numCreatedByID)
    @Html.HiddenFor(model => model.dtCreatedDate)
    @Html.HiddenFor(model => model.numUpdatetdByID)
    @Html.HiddenFor(model => model.dtUpdatetDate)
    @Html.HiddenFor(model => model.numDeletedByID)
    @Html.HiddenFor(model => model.dtDeletedDate)
    <div class="pt-4">
        <button type="submit" class="btn btn-primary me-sm-3 me-1">Submit</button>
        <button type="reset" class="btn btn-warning">Clear</button>
    </div>
}

<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
