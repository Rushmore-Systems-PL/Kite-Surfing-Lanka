@model IEnumerable<KSL_HMS.DB.Guest>

@{
    ViewBag.Guest = "active";
    ViewBag.Title = "Guest Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Assest/vendor/libs/datatables-bs5/datatables.bootstrap5.css" rel="stylesheet" />
<link href="~/Assest/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" rel="stylesheet" />
<link href="~/Assest/vendor/libs/toastr/toastr.css" rel="stylesheet" />
<link href="~/Assest/vendor/libs/animate-css/animate.css" rel="stylesheet" />

<div class="card">
    <div class="card-body">
        <h4>Guest Master</h4>
        <hr class="my-4 mx-n4" />
        <table class="datatables-basic table border-top nowrap" id="MasterTable">
            <thead>
                <tr>
                    <th class="text-center">#</th>
                    <th>Guest Name</th>
                    <th>Passport NO</th>
                    <th>Email</th>
                    <th>Age</th>
                    <th>Created Date</th>
                    <th class="text-center">Status</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int i = 1;
                    foreach (var item in ViewBag.Guests)
                    {
                        <tr>
                            <td class="text-center" width="2px">
                                .@i.ToString("00")
                            </td>
                            <td>
                                @item.varGuestName
                            </td>
                            <td>
                                @item.varGuestPPNo
                            </td>
                            <td>
                                @item.varGuestEmail
                            </td>
                            <td>
                                @item.GuestChargeType.varGuestChargeTypeName
                            </td>
                            <td>
                                @Convert.ToDateTime(item.dtCreatedDate).ToString("yyyy/MM/dd")
                            </td>
                            <td class="text-center">
                                @if (item.bitActive == true)
                                {
                                    <span class="badge bg-label-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-label-danger">Disabled</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="text-nowrap">
                                    <button class="btn btn-sm btn-icon me-2" onclick="EditGuest('@Url.Action("Edit", "Guests", new { id = item.numGuestID })')"><i class="bx bx-edit text-warning"></i></button>
                                    <button class="btn btn-sm btn-icon delete-record" onclick="SetGuestID(@item.numGuestID)"><i class="bx bx-trash text-danger"></i></button>
                                </span>
                            </td>
                        </tr>
                        i++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="GuestModal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Guest</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="GuestModalDiv"></div>
        </div>
    </div>
</div>

<div class="col-lg-3 col-md-6">
    <div class="mt-3">
        <div class="offcanvas offcanvas-bottom" data-bs-backdrop="false" tabindex="-1" id="GuestDeleteCanvas" aria-labelledby="GuestDeleteCanvasLabel">
            <div class="offcanvas-header">
                <h4 id="GuestDeleteCanvasLabel" class="offcanvas-title">Guest</h4>
                <button type="button" class="btn-close text-reset" onclick="CancelGuest()" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                <h5>Are You Sure?</h5>
                <p style="margin-top:-10px">Do You Want To Delete This Guest...!</p>
                <button type="button" class="btn btn-primary me-2" onclick="DeleteGuest()">Continue</button>
                <button type="button" class="btn btn-warning" onclick="CancelGuest()">Cancel</button>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Assest/vendor/libs/datatables/jquery.dataTables.js"></script>
<script src="~/Assest/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
<script src="~/Assest/vendor/libs/datatables-buttons/datatables-buttons.js"></script>
<script src="~/Assest/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.js"></script>
<script src="~/Assest/vendor/libs/jszip/jszip.js"></script>
<script src="~/Assest/vendor/libs/jszip/vfs_fonts.js"></script>
<script src="~/Assest/vendor/libs/datatables-buttons/buttons.html5.js"></script>
<script src="~/Assest/vendor/libs/datatables-buttons/buttons.print.js"></script>
<script src="~/Assest/vendor/libs/toastr/toastr.js"></script>
<script type="text/javascript">
    var numGuestID = 0;
    var table = $('#MasterTable').DataTable({
        scrollY: true,
        scrollX: true,
        scrollCollapse: true,
        paging: true,
        fixedColumns: false,
        ordering: false,
    });
    table.buttons().container()
        .appendTo('#MasterTable_wrapper .col-md-6:eq(0)');
    EditGuest = function (url) {
        $.get(url).done(function (response) {
            $("#GuestModalDiv").html(response);
            jQuery.noConflict();
            $('#GuestModal').modal('show');
        });
    }
    function SetGuestID(id) {
        numGuestID = id;
        $('#GuestDeleteCanvas').offcanvas('show');
    }
    function DeleteGuest() {
        $.ajax({
            type: "POST",
            url: '@Url.Action("Delete", "Guests")/' + numGuestID
        });
        location.reload();
    }
    function CancelGuest() {
        numGuestID = 0;
        $('#GuestDeleteCanvas').offcanvas('hide');
    }
    $(function myfunction() {
        var Msg = '@TempData["GuestStatus"]'
        if (Msg != '') {
           if (Msg == "Deleted") {
                toastr.options = {
                    "closeButton": true,
                    "debug": false,
                    "newestOnTop": true,
                    "progressBar": true,
                    "positionClass": "toast-top-right",
                    "preventDuplicates": false,
                    "onclick": null,
                    "showDuration": "300",
                    "hideDuration": "1000",
                    "timeOut": "5000",
                    "extendedTimeOut": "1000",
                    "showEasing": "swing",
                    "hideEasing": "linear",
                };
                toastr["error"]("Guest Deleted Successfully.", " Success");
            } else if (Msg == "Edited") {
                toastr.options = {
                    "closeButton": true,
                    "debug": false,
                    "newestOnTop": true,
                    "progressBar": true,
                    "positionClass": "toast-top-right",
                    "preventDuplicates": false,
                    "onclick": null,
                    "showDuration": "300",
                    "hideDuration": "1000",
                    "timeOut": "5000",
                    "extendedTimeOut": "1000",
                    "showEasing": "swing",
                    "hideEasing": "linear",
                };
                toastr["warning"]("Guest Updated Successfully.", " Success");
            }
        }
    })
</script>
