@model IEnumerable<KSL_HMS.DB.KiteTrainingDetail>

@{
    ViewBag.KiteTraining = "active open";
    ViewBag.TrainingMaster = "active open";
    ViewBag.TrainingDetails = "active";
    ViewBag.Title = "Training Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Assest/vendor/libs/datatables-bs5/datatables.bootstrap5.css" rel="stylesheet" />
<link href="~/Assest/vendor/libs/toastr/toastr.css" rel="stylesheet" />
<link href="~/Assest/vendor/libs/animate-css/animate.css" rel="stylesheet" />

<div class="card">
    <div class="card-body">
        <h4>Training Master</h4>
        <hr class="my-4 mx-n4" />
        <table class="datatables-basic table border-top" id="MasterTable">
            <thead>
                <tr>
                    <th class="text-center">#</th>
                    <th>Booking Reference</th>
                    <th>Guest</th>
                    <th>Item Name</th>
                    @*<th>No Of People</th>*@
                    <th>Hours</th>
                    <th>Rate</th>
                    <th>Amount</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int i = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center" width="2px">
                                .@i.ToString("00")
                            </td>
                            <td>
                                @item.KiteTrainingHeader.BookingRefference.varBookingRefferenceNo
                            </td>
                            <td>
                                @item.BookingDetail.Guest.varGuestName
                            </td>
                            <td>
                                @item.KiteTrainingHeader.Item.varItemName
                            </td>
                            @*<td>
                                @item.numTrainingPaxCount.Value.ToString("00")
                            </td>*@
                            <td>
                                @item.numKiteTrainingHours
                            </td>
                            <td>
                                € @item.numKiteTrainingRate
                            </td>
                            <td>
                                € @item.numKiteTrainingCost
                            </td>
                            <td class="text-center">
                                <span class="text-nowrap">
                                    <button class="btn btn-sm btn-icon delete-record" onclick="SetTrainingID(@item.numKiteTrainingDetailID)"><i class="bx bx-trash text-danger"></i></button>
                                </span>
                            </td>
                        </tr>
                        i++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="col-lg-3 col-md-6">
    <div class="mt-3">
        <div class="offcanvas offcanvas-bottom" data-bs-backdrop="false" tabindex="-1" id="TrainingDeleteCanvas" aria-labelledby="TrainingDeleteCanvasLabel">
            <div class="offcanvas-header">
                <h4 id="TrainingDeleteCanvasLabel" class="offcanvas-title">Training</h4>
                <button type="button" class="btn-close text-reset" onclick="CancelTraining()" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                <h5>Are You Sure?</h5>
                <p style="margin-top:-10px">Do You Want To Delete This Training...!</p>
                <button type="button" class="btn btn-primary me-2" onclick="DeleteTraining()">Continue</button>
                <button type="button" class="btn btn-warning" onclick="CancelTraining()">Cancel</button>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Assest/vendor/libs/datatables/jquery.dataTables.js"></script>
<script src="~/Assest/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
<script src="~/Assest/vendor/libs/toastr/toastr.js"></script>
<script type="text/javascript">
    var numKiteTrainingDetailID = 0;
    var table = $('#MasterTable').DataTable({
        scrollY: true,
        scrollX: true,
        scrollCollapse: true,
        paging: true,
        fixedColumns: false,
        ordering: false
    });
    function SetTrainingID(id) {
        numKiteTrainingDetailID = id;
        $('#TrainingDeleteCanvas').offcanvas('show');
    }
    function DeleteTraining() {
        $.ajax({
            type: "POST",
            url: '@Url.Action("Delete", "KiteTrainingDetails")/' + numKiteTrainingDetailID,
            success: function () {
                location.reload();
            }
        });
    }
    function CancelTraining() {
        numKiteTrainingDetailID = 0;
        $('#TrainingDeleteCanvas').offcanvas('hide');
    }
    $(function myfunction() {
        var Msg = '@TempData.Peek("KiteTrainingStatus")'
        if (Msg != '') {
            if (Msg == "Deleted") {
                toastr.options = {
                    "closeButton": true,
                    "debug": false,
                    "newestOnTop": true,
                    "progressBar": true,
                    "positionClass": "toast-top-right",
                    "preventDuplicates": false,
                    "onclick": null,
                    "showDuration": "300",
                    "hideDuration": "1000",
                    "timeOut": "5000",
                    "extendedTimeOut": "1000",
                    "showEasing": "swing",
                    "hideEasing": "linear",
                };
                toastr["success"]("Training Deleted Successfully.", " Success");
            }
        }
    })
</script>

