@model KSL_HMS.DB.KiteTrainingRate

<link href="~/Assest/vendor/libs/select2/select2.css" rel="stylesheet" />

@using (Html.BeginForm())
{
    @Html.HiddenFor(model => model.numKiteTrainingRateID)
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="row g-3">
        <div class="col-md-5">
            <label class="form-label" for="numItemIDE">Item  <sup class="text-danger">*</sup></label>
            @Html.DropDownList("numItemID", null, "", htmlAttributes: new { @class = "form-control", @required = "Select Item", @title = "Please Select Item.", @id = "numItemIDE" })
            @Html.ValidationMessageFor(model => model.numItemID, "", new { @class = "text-danger", @id = "numTrainingTypeIDE" })
        </div>
    </div>
    <br />
    <div class="row g-3">
        <div class="col-md-5">
            <label class="form-label" for="numKiteTrainingRateHours">Training Hours  <sup class="text-danger">*</sup></label>
            @Html.EditorFor(model => model.numKiteTrainingRateHours, new { htmlAttributes = new { @class = "form-control", @id = "numKiteTrainingRateHours", @type = "number", placeholder = "Training Hours...", autocomplete = "off" } })
            @Html.ValidationMessageFor(model => model.numKiteTrainingRateHours, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-5">
            <label class="form-label" for="numKiteTrainingRate">Rate (€) <sup class="text-danger">*</sup></label>
            @Html.EditorFor(model => model.numKiteTrainingRate, new { htmlAttributes = new { @class = "form-control", @id = "numKiteTrainingRate", @type = "number", placeholder = "Rate...", autocomplete = "off" } })
            @Html.ValidationMessageFor(model => model.numKiteTrainingRate, "", new { @class = "text-danger" })
        </div>
    </div>
    @Html.HiddenFor(model => model.bitActive)
    @Html.HiddenFor(model => model.numCreatedByID)
    @Html.HiddenFor(model => model.dtCreatedDate)
    @Html.HiddenFor(model => model.numUpdatetdByID)
    @Html.HiddenFor(model => model.dtUpdatetDate)
    @Html.HiddenFor(model => model.numDeletedByID)
    @Html.HiddenFor(model => model.dtDeletedDate)
    <div class="pt-4">
        <button type="submit" class="btn btn-primary me-sm-3 me-1">Submit</button>
        <button type="reset" class="btn btn-warning">Clear</button>
    </div>
}

<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Assest/vendor/libs/select2/select2.js"></script>
<script type="text/javascript">
    $("#numItemIDE").select2({
        dropdownParent: $("#KiteTrainingRatesModal"),
        placeholder: "Select Item...",
        width: 'resolve'
    });
</script>