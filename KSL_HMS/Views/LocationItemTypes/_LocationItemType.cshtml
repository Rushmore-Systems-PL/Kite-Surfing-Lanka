
@model KSL_HMS.DB.LocationItemType

<link href="~/Assest/vendor/libs/select2/select2.css" rel="stylesheet" />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger", id = "JasonErrorMsgID" })
    @Html.HiddenFor(model => model.numLocationItemTypeID)
    <div class="row g-3">
        <div class="col-md-5">
            <label class="form-label" for="numLocationIDE">Location  <sup class="text-danger">*</sup></label>
            @Html.DropDownList("numLocationID", null, "", htmlAttributes: new { @class = "form-control", @required = "Select Item Category", @title = "Please Select Location.", @id = "numLocationIDE" })
            @Html.ValidationMessageFor(model => model.numLocationID, "", new { @class = "text-danger", @id = "numLocationIDE" })
            <p class="text-danger" id="JasonnumErrorMsgE"></p>
        </div>
        <div class="col-md-5">
            <label class="form-label" for="numItemTypeIDE">Item  Category<sup class="text-danger">*</sup></label>
            @Html.DropDownList("numItemTypeID", null, "", htmlAttributes: new { @class = "form-control", @required = "Select Item Category", @title = "Please Select Item Category.", @id = "numItemTypeIDE" })
            @Html.ValidationMessageFor(model => model.numItemTypeID, "", new { @class = "text-danger", @id = "numItemTypeIDE" })
        </div>
    </div>
    <br />
    @Html.HiddenFor(model => model.bitActive)
    @Html.HiddenFor(model => model.numCreatedByID)
    @Html.HiddenFor(model => model.dtCreatedDate)
    @Html.HiddenFor(model => model.numUpdatetdByID)
    @Html.HiddenFor(model => model.dtUpdatetDate)
    @Html.HiddenFor(model => model.numDeletedByID)
    @Html.HiddenFor(model => model.dtDeletedDate)
    <div class="pt-4">
        <button type="submit" class="btn btn-primary me-sm-3 me-1" id="LoacationItemSubmitBtnE">Submit</button>
        <button type="reset" class="btn btn-warning">Clear</button>
    </div>
}

<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Assest/vendor/libs/select2/select2.js"></script>
<script type="text/javascript">
    $("#numLocationIDE").select2({
        dropdownParent: $("#LocationItemTypesModal"),
        placeholder: "Select Location...",
        width: 'resolve'
    });
    $("#numItemTypeIDE").select2({
        dropdownParent: $("#LocationItemTypesModal"),
        placeholder: "Select Item Category...",
        width: 'resolve'
    });
    $('#numLocationIDE').on('change', function () {
        var Lid = $('#numLocationIDE option:selected').val();
        var Iid = $('#numItemTypeIDE option:selected').val();
        CheckLoactionItems(Lid, Iid);
    });
    $('#numItemTypeIDE').on('change', function () {
        var Lid = $('#numLocationIDE option:selected').val();
        var Iid = $('#numItemTypeIDE option:selected').val();
        CheckLoactionItems(Lid, Iid);
    });
    function CheckLoactionItems(Lid, Iid) {
        if (Lid != null && Iid != null) {
            $.ajax({
                type: 'GET',
                data: { numLocationID: Lid, numItemTypeID: Iid },
                url: '@Url.Action("IsAlreadyExists", "LocationItemTypes")',
                success: function (result) {
                    if (result == true) {
                        document.getElementById('JasonnumErrorMsgE').innerText = "";
                        document.getElementById("LoacationItemSubmitBtnE").disabled = false;
                    } else {
                        document.getElementById('JasonnumErrorMsgE').innerText = "Selected Location And Item Already Available.";
                        document.getElementById("LoacationItemSubmitBtnE").disabled = true;
                    }
                }
            });
        }
    }
</script>