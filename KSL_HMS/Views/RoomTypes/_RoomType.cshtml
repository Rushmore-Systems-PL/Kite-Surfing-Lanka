@model KSL_HMS.DB.RoomType

@using (Html.BeginForm("Edit", "RoomTypes", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.numRoomTypeID)
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label" for="varRoomTypeName">Room Category Name  <sup class="text-danger">*</sup></label>
            @Html.EditorFor(model => model.varRoomTypeName, new { htmlAttributes = new { @class = "form-control", @id = "varRoomTypeName", @type = "text", placeholder = "Category Name...", autocomplete = "off" } })
            @Html.ValidationMessageFor(model => model.varRoomTypeName, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-3">
            <label class="form-label" for="varRoomTypeName">Room Category Image <span class="text-danger">(PNG)</span></label>
            <input class="form-control" type="file" id="RoomCategoryImage" name="RoomCategoryImage" autocomplete="off">
            @Html.ValidationMessageFor(model => model.RoomCategoryImage, "", new { @class = "text-danger" })
        </div>
    </div>
    <br />
    <div class="row g-3">
        <div class="col-md-8">
            <label class="form-label" for="varRoomTypeDescription">Room Category Description</label>
            @Html.EditorFor(model => model.varRoomTypeDescription, new { htmlAttributes = new { @class = "form-control", @id = "varRoomTypeDescription", @type = "text", placeholder = "Description...", autocomplete = "off", cols = 100, @rows = 3 } })
            @Html.ValidationMessageFor(model => model.varRoomTypeDescription, "", new { @class = "text-danger", @id = "varRoomTypeDescription" })
        </div>
    </div>
    @Html.HiddenFor(model => model.bitActive)
    @Html.HiddenFor(model => model.numCreatedByID)
    @Html.HiddenFor(model => model.dtCreatedDate)
    @Html.HiddenFor(model => model.numUpdatetdByID)
    @Html.HiddenFor(model => model.dtUpdatetDate)
    @Html.HiddenFor(model => model.numDeletedByID)
    @Html.HiddenFor(model => model.dtDeletedDate)
    <div class="pt-4">
        <button type="submit" class="btn btn-primary me-sm-3 me-1">Submit</button>
        <button type="reset" class="btn btn-warning">Clear</button>
    </div>
}


<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>