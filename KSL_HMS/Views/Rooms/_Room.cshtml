@model KSL_HMS.DB.Room

<link href="~/Assest/vendor/libs/select2/select2.css" rel="stylesheet" />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.numRoomID)
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label" for="numRoomTypeIDE">Room Category  <sup class="text-danger">*</sup></label>
            @Html.DropDownList("numRoomTypeID", null, "", htmlAttributes: new { @class = "form-control", @required = "Select Room Category", @title = "Please Select Room Category.", @id = "numRoomTypeIDE" })
            @Html.ValidationMessageFor(model => model.numRoomTypeID, "", new { @class = "text-danger", @id = "numRoomTypeIDE" })
        </div>
        <div class="col-md-6">
            <label class="form-label" for="varRoomName">Room Name </label>
            @Html.EditorFor(model => model.varRoomName, new { htmlAttributes = new { @class = "form-control", @id = "varRoomName", @type = "text", placeholder = "Name...", autocomplete = "off" } })
            @Html.ValidationMessageFor(model => model.varRoomName, "", new { @class = "text-danger" })
        </div>
    </div>
    <br />
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label" for="varRoomNo">Room No  <sup class="text-danger">*</sup></label>
            @Html.EditorFor(model => model.varRoomNo, new { htmlAttributes = new { @class = "form-control", @id = "varRoomNo", placeholder = "No...", autocomplete = "off" } })
            @Html.ValidationMessageFor(model => model.varRoomNo, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-4">
            <label class="form-label" for="numMaxPaxAllowed">Maximum Pax Allowed <sup class="text-danger">*</sup></label>
            @Html.EditorFor(model => model.numMaxPaxAllowed, new { htmlAttributes = new { @class = "form-control", @id = "numMaxPaxAllowed", @type = "number", placeholder = "Pax...", autocomplete = "off" } })
            @Html.ValidationMessageFor(model => model.numMaxPaxAllowed, "", new { @class = "text-danger" })
        </div>
    </div>
    <br />
    <div class="row g-3">
        <div class="col-md-8">
            <label class="form-label" for="varRoomDescription">Room Description</label>
            @Html.EditorFor(model => model.varRoomDescription, new { htmlAttributes = new { @class = "form-control", @id = "varRoomDescription", @type = "text", placeholder = "Description...", autocomplete = "off", cols = 100, @rows = 3 } })
            @Html.ValidationMessageFor(model => model.varRoomDescription, "", new { @class = "text-danger", @id = "varRoomDescription" })
        </div>
    </div>
    @Html.HiddenFor(model => model.bitActive)
    @Html.HiddenFor(model => model.numCreatedByID)
    @Html.HiddenFor(model => model.dtCreatedDate)
    @Html.HiddenFor(model => model.numUpdatetdByID)
    @Html.HiddenFor(model => model.dtUpdatetDate)
    @Html.HiddenFor(model => model.numDeletedByID)
    @Html.HiddenFor(model => model.dtDeletedDate)
    <div class="pt-4">
        <button type="submit" class="btn btn-primary me-sm-3 me-1">Submit</button>
        <button type="reset" class="btn btn-warning">Clear</button>
    </div>
}

<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Assest/vendor/libs/select2/select2.js"></script>
<script type="text/javascript">
    $("#numRoomTypeIDE").select2({
        dropdownParent: $("#RoomsModal"),
        placeholder: "Select Room Category...",
        width: 'resolve'
    });
</script>