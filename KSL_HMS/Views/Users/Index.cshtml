@model IEnumerable<KSL_HMS.DB.User>

@{
	ViewBag.User = "active open";
	ViewBag.Users = "active";
	ViewBag.Title = "User Master";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Assest/vendor/libs/datatables-bs5/datatables.bootstrap5.css" rel="stylesheet" />
<link href="~/Assest/vendor/libs/toastr/toastr.css" rel="stylesheet" />
<link href="~/Assest/vendor/libs/animate-css/animate.css" rel="stylesheet" />

<div class="card">
	<div class="card-body">
		<h4>User Master</h4>
		<hr class="my-4 mx-n4" />
		<table class="datatables-basic table border-top" id="MasterTable">
			<thead>
				<tr>
					<th class="text-center">#</th>
					<th>User Name</th>
					<th>Logging Name</th>
					<th>NIC</th>
					<th>Permission</th>
					<th>Created Date</th>
					<th class="text-center">Action</th>
				</tr>
			</thead>
			<tbody>
				@{
					int i = 1;
					foreach (var item in Model)
					{
						<tr>
							<td class="text-center" width="2px">
								.@i.ToString("00")
							</td>
							<td>
								@item.varFirstName @item.varLastName
							</td>
							<td>
								@item.varUserName
							</td>
							<td>
								@item.varNIC
							</td>
							<td>
								@item.Permission.varPermissionName
							</td>
							<td>
								@item.dtCreatedDate.Value.ToString("yyyy/MM/dd")
							</td>
							<td class="text-center">
								<span class="text-nowrap">
									<button class="btn btn-sm btn-icon me-2" onclick="EditUsers('@Url.Action("Edit", "Users", new { id = item.numUserID })')"><i class="bx bx-edit text-warning"></i></button>
									<button class="btn btn-sm btn-icon delete-record" onclick="SetUsersID(@item.numUserID)"><i class="bx bx-trash text-danger"></i></button>
								</span>
							</td>
						</tr>
						i++;
					}
				}
			</tbody>
		</table>
	</div>
</div>

<div class="modal fade" id="UsersModal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true" role="dialog">
	<div class="modal-dialog modal-xl" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h4 class="modal-title">User</h4>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="DisableValidation(document.getElementById('numUserID').value)"></button>
			</div>
			<div class="modal-body" id="UsersModalDiv"></div>
		</div>
	</div>
</div>

<div class="col-lg-3 col-md-6">
	<div class="mt-3">
		<div class="offcanvas offcanvas-bottom" data-bs-backdrop="false" tabindex="-1" id="UsersDeleteCanvas" aria-labelledby="UsersDeleteCanvasLabel">
			<div class="offcanvas-header">
				<h4 id="UsersDeleteCanvasLabel" class="offcanvas-title">User</h4>
				<button type="button" class="btn-close text-reset" onclick="CancelUsers()" aria-label="Close"></button>
			</div>
			<div class="offcanvas-body">
				<h5>Are You Sure?</h5>
				<p style="margin-top:-10px">Do You Want To Delete This User...!</p>
				<button type="button" class="btn btn-primary me-2" onclick="DeleteUsers()">Continue</button>
				<button type="button" class="btn btn-warning" onclick="CancelUsers()">Cancel</button>
			</div>
		</div>
	</div>
</div>

<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Assest/vendor/libs/datatables/jquery.dataTables.js"></script>
<script src="~/Assest/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
<script src="~/Assest/vendor/libs/toastr/toastr.js"></script>
<script type="text/javascript">
	var numUsersID = 0;
	var table = $('#MasterTable').DataTable({
		scrollY: true,
		scrollX: true,
		scrollCollapse: true,
		paging: true,
		fixedColumns: false,
		ordering: false
	});
	EditUsers = function (url) {
		$.get(url).done(function (response) {
			$("#UsersModalDiv").html(response);
			jQuery.noConflict();
			$('#UsersModal').modal('show');
		});
	}
	function DisableValidation(id) {
		$.ajax({
			type: 'POST',
			data: { id: id },
			url: '@Url.Action("ChangeValidationStatus", "Users")',
		});
	}
	function SetUsersID(id) {
		numUsersID = id;
		$('#UsersDeleteCanvas').offcanvas('show');
	}
	function DeleteUsers() {
		$.ajax({
			type: "POST",
			url: '@Url.Action("Delete", "Users")/' + numUsersID
		});
		location.reload();
	}
	function CancelUsers() {
		numUsersID = 0;
		$('#UsersDeleteCanvas').offcanvas('hide');
	}
	$(function myfunction() {
		var Msg = '@TempData["UserStatus"]'
		if (Msg != '') {
			if (Msg == "Saved") {
				toastr.options = {
					"closeButton": true,
					"debug": false,
					"newestOnTop": true,
					"progressBar": true,
					"positionClass": "toast-top-right",
					"preventDuplicates": false,
					"onclick": null,
					"showDuration": "300",
					"hideDuration": "1000",
					"timeOut": "5000",
					"extendedTimeOut": "1000",
					"showEasing": "swing",
					"hideEasing": "linear",
				};
				toastr["success"]("User Saved Successfully.", " Success");
			} else if (Msg == "Deleted") {
				toastr.options = {
					"closeButton": true,
					"debug": false,
					"newestOnTop": true,
					"progressBar": true,
					"positionClass": "toast-top-right",
					"preventDuplicates": false,
					"onclick": null,
					"showDuration": "300",
					"hideDuration": "1000",
					"timeOut": "5000",
					"extendedTimeOut": "1000",
					"showEasing": "swing",
					"hideEasing": "linear",
				};
				toastr["error"]("User Deleted Successfully.", " Success");
			} else if (Msg == "Edited") {
				toastr.options = {
					"closeButton": true,
					"debug": false,
					"newestOnTop": true,
					"progressBar": true,
					"positionClass": "toast-top-right",
					"preventDuplicates": false,
					"onclick": null,
					"showDuration": "300",
					"hideDuration": "1000",
					"timeOut": "5000",
					"extendedTimeOut": "1000",
					"showEasing": "swing",
					"hideEasing": "linear",
				};
				toastr["warning"]("User Updated Successfully.", " Success");
			}
		}
	})
</script>
