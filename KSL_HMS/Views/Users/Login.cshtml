@model KSL_HMS.DB.User

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="light-style  customizer-hide" dir="ltr" data-theme="theme-default" data-assets-path="~/Assest/" data-template="vertical-menu-template">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <title>Login | KITESURFING </title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com/">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&amp;display=swap" rel="stylesheet">
    <link href="~/Assest/vendor/fonts/boxicons.css" rel="stylesheet" />
    <link href="~/Assest/vendor/fonts/fontawesome.css" rel="stylesheet" />
    <link href="~/Assest/vendor/fonts/flag-icons.css" rel="stylesheet" />
    <link href="~/Assest/vendor/css/rtl/core.css" rel="stylesheet" />
    <link href="~/Assest/vendor/css/rtl/theme-default.css" rel="stylesheet" />
    <link href="~/Assest/css/demo.css" rel="stylesheet" />
    <link href="~/Assest/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" rel="stylesheet" />
    <link href="~/Assest/vendor/libs/typeahead-js/typeahead.css" rel="stylesheet" />
    <link href="~/Assest/vendor/libs/formvalidation/dist/css/formValidation.min.css" rel="stylesheet" />
    <link href="~/Assest/vendor/css/pages/page-auth.css" rel="stylesheet" />
    <script src="~/Assest/vendor/js/helpers.js"></script>
    <script src="~/Assest/js/config.js"></script>
    <link href="~/Assest/vendor/libs/toastr/toastr.css" rel="stylesheet" />
    <link href="~/Assest/vendor/libs/animate-css/animate.css" rel="stylesheet" />
</head>
<body style="background-color:#E0E0E0;overflow:hidden">
    <div class="authentication-wrapper authentication-cover">
        <div class="authentication-inner row m-0">
            <div class="d-none d-lg-flex col-lg-7 col-xl-8 align-items-center p-5">
                <div class="w-100 d-flex justify-content-center">
                    <img src="~/Assest/customer/KSL_Girl_ST_2000_B.jpg" class="img-fluid" alt="Login image" width="700" data-app-dark-img="illustrations/boy-with-rocket-dark.png" data-app-light-img="illustrations/boy-with-rocket-light.png" style="margin-top:-25px">
                </div>
            </div>
            <div class="d-flex col-12 col-lg-5 col-xl-4 align-items-center authentication-bg p-sm-5 p-4">
                <div class="w-px-400 mx-auto">
                    <h4 class="mb-2">Welcome! 👋</h4>
                    <p class="mb-4">Please sign-in to your account</p>
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <p class="text-danger">@ViewBag.UserNoExistError@ViewBag.UserPwdError</p>
                        <div class="mb-3">
                            <label class="form-label" for="UserName">User Name </label>
                            @{ Html.EnableClientValidation(false); }
                            @Html.EditorFor(model => model.varUserName, new { htmlAttributes = new { @class = "form-control", @id = "UserName", placeholder = "User Name...", autocomplete = "off", @required = "", @title = "Please Enter User Name." } })
                            @Html.ValidationMessageFor(model => model.varUserName, "", new { @class = "text-danger" })
                            @{ Html.EnableClientValidation(true); }
                        </div>
                        <div class="mb-3 form-password-toggle">
                            <div class="d-flex justify-content-between">
                                <label class="form-label">Password</label>
                                <a href="#">
                                    <small>Forgot Password?</small>
                                </a>
                            </div>
                            <div class="input-group input-group-merge">
                                @Html.EditorFor(model => model.varPassword, new { htmlAttributes = new { @class = "form-control", @id = "UserPwd", placeholder = "Password...", autocomplete = "off", @required = "", @title = "Please Enter Password." } })
                                <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
                            </div>
                            @Html.ValidationMessageFor(model => model.varPassword, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="remember-me" checked="checked">
                                <label class="form-check-label" for="remember-me">
                                    Remember Me
                                </label>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary d-grid w-100">
                            Sign in
                        </button>
                    }
                    <p class="text-center">
                        <span>New on our platform?</span>
                        <a href="/Users/Register">
                            <span>Create an account</span>
                        </a>
                    </p>
                    <div class="divider my-4">
                        <div class="divider-text">or</div>
                    </div>
                    <div class="d-flex justify-content-center">
                        <a href="https://www.facebook.com/kitesurfinglankasrilanka/" target="_blank" class="btn btn-icon btn-label-facebook me-3">
                            <i class="tf-icons bx bxl-facebook"></i>
                        </a>
                        <a href="https://www.instagram.com/kitesurfinglanka/" target="_blank" class="btn btn-icon btn-label-instagram me-3">
                            <i class='tf-icons bx bxl-instagram'></i>
                        </a>
                        <a href="https://vimeo.com/kitesurfinglanka" target="_blank" class="btn btn-icon btn-label-vimeo me-3">
                            <i class='tf-icons bx bxl-vimeo'></i>
                        </a>
                        <a href="https://www.tripadvisor.com/Hotel_Review-g1404719-d3335783-Reviews-Kitesurfing_Lanka_Kalpitiya-Kalpitiya_North_Western_Province.html" target="_blank" class="btn btn-icon btn-label-success">
                            <i class='tf-icons bx bxl-trip-advisor'></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/Assest/vendor/libs/popper/popper.js"></script>
    <script src="~/Assest/vendor/js/bootstrap.js"></script>
    <script src="~/Assest/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="~/Assest/vendor/libs/hammer/hammer.js"></script>
    <script src="~/Assest/vendor/libs/i18n/i18n.js"></script>
    <script src="~/Assest/vendor/libs/typeahead-js/typeahead.js"></script>
    <script src="~/Assest/vendor/js/menu.js"></script>
    <script src="~/Assest/vendor/libs/formvalidation/dist/js/FormValidation.min.js"></script>
    <script src="~/Assest/vendor/libs/formvalidation/dist/js/plugins/Bootstrap5.min.js"></script>
    <script src="~/Assest/vendor/libs/formvalidation/dist/js/plugins/AutoFocus.min.js"></script>
    <script src="~/Assest/js/main.js"></script>
    <script src="~/Assest/vendor/libs/select2/select2.js"></script>
    <script src="~/Assest/js/pages-auth.js"></script>
    <script src="~/Assest/vendor/libs/toastr/toastr.js"></script>
    <script type="text/javascript">
    $(function myfunction() {
        var Msg = '@TempData["SucessMsg"]'
        if (Msg != '') {
            if (Msg == "Welcome") {
                toastr.options = {
                    "closeButton": true,
                    "debug": false,
                    "newestOnTop": true,
                    "progressBar": true,
                    "positionClass": "toast-top-right",
                    "preventDuplicates": false,
                    "onclick": null,
                    "showDuration": "300",
                    "hideDuration": "1000",
                    "timeOut": "5000",
                    "extendedTimeOut": "1000",
                    "showEasing": "swing",
                    "hideEasing": "linear",
                };
                toastr["success"]("User Created Successfully.", " Success");
            }
        }
    })
    </script>
</body>
</html>